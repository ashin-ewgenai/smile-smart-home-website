rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Helper Functions =================
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/Accounts/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role : null;
    }

    function isAdmin() {
      let role = userRole();
      return role == 'admin' || role == 'Super Admin';
    }

    function isValidEmail(email) {
      return email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }

    // ================= Accounts =================
    match /Accounts/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow create: if isSignedIn();
      allow delete: if isAdmin();

      // Only admins can freely update. A user may update ONLY these fields on their own doc.
      allow update: if isAdmin() || (
        isCurrentUser(uid) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'FullName', 'phoneNumber', 'address', 'LastLoginAt', 'Email', 'profilePic', 'updatedAt'
        ])
      );
    }

    // ================= Estimation Quote =================
    function isEstimationOwner(estDoc) {
      return (
        (request.auth.token.email != null && estDoc.customerEmail == request.auth.token.email) ||
        (estDoc.uid != null && estDoc.uid == request.auth.uid)
      );
    }

    function ownsOriginalQuote(estDoc) {
      return isSignedIn() && estDoc.originalQuoteId != null &&
        exists(/databases/$(database)/documents/quotes/$(estDoc.originalQuoteId)) &&
        get(/databases/$(database)/documents/quotes/$(estDoc.originalQuoteId)).data.userUid == request.auth.uid;
    }

    match /Estimation_Quote/{docId} {
      allow read: if isAdmin() || (isSignedIn() && (isEstimationOwner(resource.data) || ownsOriginalQuote(resource.data)));

      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.token.email != null && request.resource.data.customerEmail == request.auth.token.email) ||
        (request.resource.data.uid != null && request.resource.data.uid == request.auth.uid)
      );

      allow update: if isSignedIn() &&
        (isAdmin() || isEstimationOwner(resource.data));

      allow delete: if isAdmin();
    }

    // ================= Legacy Estimation Quote (with space in name) =================
    match /{collectionId}/{docId} {
      allow read: if collectionId == "Estimation Quote" &&
        (isAdmin() || (isSignedIn() && isEstimationOwner(resource.data)));

      allow create: if collectionId == "Estimation Quote" &&
        isSignedIn() && (
          isAdmin() ||
          (request.auth.token.email != null && request.resource.data.customerEmail == request.auth.token.email) ||
          (request.resource.data.uid != null && request.resource.data.uid == request.auth.uid)
        );

      allow update: if collectionId == "Estimation Quote" &&
        (isSignedIn() && (isAdmin() || isEstimationOwner(resource.data)));

      allow delete: if collectionId == "Estimation Quote" && isAdmin();
    }

    // ================= Planner Leads =================
    match /Planner_Leads/{docId} {
      allow read, write: if isAdmin();
    }

    // ================= Request Service =================
    match /Request_service/{requestId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() &&
        ((resource.data.uid == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // ================= Support Tickets =================
    match /Support_Tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ================= User Devices =================
    match /User_Devices/{docId} {
      allow read, write: if isSignedIn() && (
        resource.data.uid == request.auth.uid || 
        request.resource.data.uid == request.auth.uid ||
        isAdmin()
      );
    }

    // ================= User Notifications =================
    match /User_Notifications/{notificationId} {
      allow read, write: if isSignedIn() && (
        resource.data.uid == request.auth.uid || 
        request.resource.data.uid == request.auth.uid ||
        isAdmin()
      );
    }

    // ================= Admin Notifications =================
    match /Admin_Notifications/{notificationId} {
      allow read, write: if isAdmin();
    }

    // ================= Chat Sessions =================
    match /chat_sessions/{sessionId} {
      allow read, create, update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if false;

      match /messages/{msgId} {
        allow read, create: if isSignedIn() &&
          (get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.ownerUid == request.auth.uid || isAdmin());
        allow update, delete: if false;
      }
    }

    // ================= Contact Requests =================
    match /contactRequests/{docId} {
      allow create: if request.resource.data.keys().hasOnly(
        ['fullName','email','phone','message','createdAt','status','service']
      );
      allow read, update, delete: if isAdmin();
    }

    // ================= Quotes =================
    match /quotes/{quoteId} {
      allow list, get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());

      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;

      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userUid == request.auth.uid &&
        request.resource.data.status == 'Cancelled' &&
        request.resource.data.cancelledByUid == request.auth.uid
      );

      allow delete: if isAdmin();
    }

    // ================= Devices =================
    match /Devices/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ================= Product Docs =================
    match /product_docs/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ================= Rate Limits =================
    match /rate_limits/{uid} {
      allow read, write: if isCurrentUser(uid) || isAdmin();
    }

    // ================= Support Status / Claims =================
    match /support_status/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /support_claims/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /support_requests/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow create, update: if isCurrentUser(uid);
      allow delete: if isAdmin();
    }

    // ================= Nested Quotes per User =================
    match /Quotes/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();

      match /Quote_List/{id} {
        allow read: if isCurrentUser(uid) || isAdmin();
        allow create: if isCurrentUser(uid);
        allow update, delete: if isCurrentUser(uid) || isAdmin();
      }
    }

    // ================= Admin Service Requests (flat) =================
    match /service_requests/{docId} {
      allow read, create, update, delete: if isAdmin();
    }

    // ================= Users lookup (admin-only) =================
    match /users/{uid} {
      allow read: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ================= Legacy Support Tickets =================
    match /Contact_Messages/{docId} {
      allow read, update, delete: if isAdmin();
      allow create: if false;
    }

    // ================= Nested Support Tickets =================
    match /supportTickets/{uid} {
      allow read: if isAdmin();
      match /ticket/{ticketId} {
        allow read, create, update, delete: if isAdmin();
      }
    }

    // ================= Alerts (admin-only) =================
    match /Alerts/{docId} {
      allow read, create, update, delete: if isAdmin();
    }
  }
}
