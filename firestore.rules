rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // Estimation Quote collection: allow a user to read their own quotes
    // Documents may identify the user by either uid or customerEmail
    match /Estimation Quote/{docId} {
      allow read: if isSignedIn() && (
        // By uid field
        (resource.data.uid != null && resource.data.uid == request.auth.uid) ||
        // By customerEmail field (compare to authenticated email if present in token)
        (resource.data.customerEmail != null && request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email)
      );
      // Writes restricted to admins (created by admin tools or functions)
      allow create, update, delete: if isAdmin();
    }
    
    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/Accounts/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role in ['Admin', 'Super Admin'];
    }

    // Users collection (existing project may already have rules; keep permissive here)
    match /users/{uid} {
      allow read, write: if isCurrentUser(uid);
    }

    // Accounts collection - user role information
    match /Accounts/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow create: if isAdmin(); // Admins and Super Admins can create accounts
      allow update: if isAdmin(); // Admins and Super Admins can update accounts
      allow delete: if isAdmin(); // Admins and Super Admins can delete accounts
    }

    // Chat sessions stored at top-level: chat_sessions/{sessionId}
    match /chat_sessions/{sessionId} {
      allow read, write: if isOwner() || isAdmin();

      function isOwner() {
        // On create, `ownerUid` comes from request.resource
        return isSignedIn() && (
          request.resource.data.ownerUid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid
        );
      }

      // Messages subcollection
      match /messages/{msgId} {
        allow read, write: if isOwner() || isAdmin();
      }
    }

    // Devices collection
    match /devices/{deviceId} {
      allow read: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
      allow create, update, delete: if isAdmin(); // Admins and Super Admins can manage devices
    }

    // Quotes: top-level collection `quotes/{quoteId}`
    // - Authenticated users can create a quote only for themselves (userUid must match request.auth.uid)
    // - Authenticated users can read only their own quotes
    // - Admins can read/update any quote
    // - Admins can delete quotes
    match /quotes/{quoteId} {
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid &&
        // Validate required fields and types
        request.resource.data.keys().hasAll(['userUid', 'details', 'status', 'createdAt']) &&
        request.resource.data.userUid is string &&
        request.resource.data.details is string && request.resource.data.details.size() > 0 &&
        request.resource.data.status == 'pending' &&
        request.resource.data.createdAt is timestamp;
      allow read: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update: if isAdmin();
      allow delete: if isAdmin(); // Admins and Super Admins can delete quotes
    }

    // Support tickets: flat collection Support_Tickets/{ticketId}
    // Allow authenticated user to read/write ONLY their own tickets (based on uid field)
    match /Support_Tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid &&
        // Validate required fields
        request.resource.data.keys().hasAll(['uid', 'complaint', 'status', 'createdAt']) &&
        request.resource.data.uid is string &&
        request.resource.data.complaint is string && request.resource.data.complaint.size() > 0 &&
        request.resource.data.status in ['open', 'pending', 'resolved', 'closed', 'Cancelled'] &&
        request.resource.data.createdAt is timestamp;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin(); // Admins and Super Admins can delete tickets
    }

    // Global support availability status
    // support_status/global -> { online: boolean, updatedAt: number, updatedBy: uid }
    match /support_status/{docId} {
      allow read: if isSignedIn(); // any signed-in user can read status
      allow write: if isAdmin(); // Admins and Super Admins can toggle
    }

    // Per-user human claim: when true, humans handle this user's chat (AI disabled)
    match /support_claims/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow write: if isAdmin();
    }

    // Per-user human request: user can raise, admin can clear
    match /support_requests/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow create, update: if isCurrentUser(uid);
      allow delete: if isAdmin();
    }

    // Rate limiting collection for chat functions
    match /rate_limits/{uid} {
      allow read, write: if isCurrentUser(uid) || isAdmin();
    }

    // Admin notifications
    match /admin_notifications/{notificationId} {
      allow read: if isAdmin();
      allow create: if isSignedIn(); // Functions can create notifications
      allow update, delete: if isAdmin();
    }

    // User notifications: top-level collection `notifications/{notificationId}`
    // Allow authenticated users to read ONLY their own notifications (matched by userId field)
    match /notifications/{notificationId} {
      // Read allowed if the document's userId equals the requester uid
      allow read: if isSignedIn() && resource.data.userId == request.auth.uid;
      // Optional: allow creation from client or functions, adjust as needed
      // Consider restricting to Cloud Functions or admins only in production
      allow create: if isSignedIn();
      // Allow the owner (or admin) to update only the 'status' field (e.g., mark as read)
      allow update: if (
        (isSignedIn() && resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).changedKeys().hasOnly(['status']))
        || isAdmin()
      );
      // Disallow deletes by default (adjust if you want to let admins delete)
      allow delete: if isAdmin();
    }

    // Product documentation
    match /product_docs/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin(); // Admins and Super Admins can manage product docs
    }

    // Public contact form submissions: create-only into contactRequests
    // Anyone (including unauthenticated) may create a request, but no reads/updates/deletes
    match /contactRequests/{docId} {
      allow create: if isValidContactRequest();
      allow read, update, delete: if false;

      function isValidContactRequest() {
        // Only allow these fields
        return request.resource.data.keys().hasOnly(['fullName','email','phone','message','createdAt','status','service'])
          // Required fields and types
          && (request.resource.data.fullName is string && request.resource.data.fullName.size() > 0)
          && (request.resource.data.email is string && request.resource.data.email.size() > 0)
          && (request.resource.data.message is string && request.resource.data.message.size() > 0)
          && (request.resource.data.createdAt is timestamp)
          && (request.resource.data.status == 'pending')
          // Optional fields if present must be strings or null
          && (!request.resource.data.keys().hasAny(['phone']) || request.resource.data.phone is string || request.resource.data.phone == null)
          && (!request.resource.data.keys().hasAny(['service']) || request.resource.data.service is string || request.resource.data.service == null);
      }
    }

    // Contact messages from the website
    match /Contact_Messages/{messageId} {
      // Allow admins to read all contact messages
      allow read: if isAdmin();
      // Allow creation of new contact messages (from the website)
      allow create: if request.resource.data.keys().hasAll(['email', 'message', 'createdAt'])
        && request.resource.data.email is string
        && request.resource.data.message is string
        && request.resource.data.createdAt is timestamp;
      // Allow admins to update status of messages
      allow update: if isAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'adminRead']);
    }
  }
}
