rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users collection (existing project may already have rules; keep permissive here)
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Chat sessions stored at top-level: chat_sessions/{sessionId}
    match /chat_sessions/{sessionId} {
      allow read, write: if isOwner() || isAdmin();

      function isOwner() {
        // On create, `ownerUid` comes from request.resource
        return request.auth != null && (
          request.resource.data.ownerUid == request.auth.uid ||
          resource.data.ownerUid == request.auth.uid
        );
      }

      // Admin roles are stored in Accounts collection under field `Role`
      function isAdmin() {
        return request.auth != null && (
          get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role == "Admin" ||
          get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role == "Super Admin"
        );
      }

      // Messages subcollection
      match /messages/{msgId} {
        allow read, write: if isOwner() || isAdmin();
      }
    }

    // Quotes: top-level collection `quotes/{quoteId}`
    // - Authenticated users can create a quote only for themselves (userUid must match request.auth.uid)
    // - Authenticated users can read only their own quotes
    // - Admins can read/update/delete any quote
    match /quotes/{quoteId} {
      allow create: if request.auth != null && request.resource.data.userUid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.userUid == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Support tickets: flat collection Support_Tickets/{ticketId}
    // Allow authenticated user to read/write ONLY their own tickets (based on uid field)
    match /Support_Tickets/{ticketId} {
      allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
      allow update, delete: if request.auth != null && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // Global support availability status
    // support_status/global -> { online: boolean, updatedAt: number, updatedAt: number, updatedBy: uid }
    match /support_status/{docId} {
      allow read: if request.auth != null; // any signed-in user can read status
      allow write: if isAdmin(); // only Admin/Super Admin can toggle

      function isAdmin() {
        return request.auth != null && (
          get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role == "Admin" ||
          get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role == "Super Admin"
        );
      }
    }

    // Per-user human claim: when true, humans handle this user's chat (AI disabled)
    match /support_claims/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // Per-user human request: user can raise, admin can clear
    match /support_requests/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow delete: if isAdmin();
    }

    // Public contact form submissions: create-only into contactRequests
    // Anyone (including unauthenticated) may create a request, but no reads/updates/deletes
    match /contactRequests/{docId} {
      allow create: if isValidContactRequest();
      allow read, update, delete: if false;

      function isValidContactRequest() {
        // Only allow these fields
        return request.resource.data.keys().hasOnly(['fullName','email','phone','message','createdAt','status','service'])
          // Required fields and types
          && (request.resource.data.fullName is string && request.resource.data.fullName.size() > 0)
          && (request.resource.data.email is string && request.resource.data.email.size() > 0)
          && (request.resource.data.message is string && request.resource.data.message.size() > 0)
          && (request.resource.data.createdAt is timestamp)
          && (request.resource.data.status == 'pending')
          // Optional fields if present must be strings or null
          && (!request.resource.data.keys().hasAny(['phone']) || request.resource.data.phone is string || request.resource.data.phone == null)
          && (!request.resource.data.keys().hasAny(['service']) || request.resource.data.service is string || request.resource.data.service == null);
      }
    }

    function isAdmin() {
      return exists(/databases/$(database)/documents/Accounts/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role in ['Admin','SuperAdmin','Owner','Manager','Support'];
    }
  }
}
