rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ================= Helper Functions =================
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userRole() {
      return isSignedIn() && exists(/databases/$(database)/documents/Accounts/$(request.auth.uid)) ?
        get(/databases/$(database)/documents/Accounts/$(request.auth.uid)).data.Role : null;
    }

    function isAdmin() {
      let role = userRole();
      return role == 'admin' || role == 'Super Admin';
    }

    function isValidEmail(email) {
      return email.matches('^[^@]+@[^@]+\\.[^@]+$');
    }

    // ================= Accounts =================
    match /Accounts/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ================= Estimation Quote =================
    match /Estimation_Quote/{docId} {
      // Read: Admin OR owner (by email)
      allow read: if isAdmin() ||
        (isSignedIn() && request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email);

      // Create: Must match logged-in email
      allow create: if isSignedIn() &&
        request.auth.token.email != null &&
        request.resource.data.customerEmail == request.auth.token.email;

      // Update: Owner (by email) or admin
      allow update: if isSignedIn() &&
        ((request.auth.token.email != null && resource.data.customerEmail == request.auth.token.email) || isAdmin());

      // Delete: Admin only
      allow delete: if isAdmin();
    }

    // ================= Planner Leads =================
    match /Planner_Leads/{docId} {
      allow read, write: if isAdmin();
    }

    // ================= Request Service =================
    match /Request_service/{requestId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow update: if isSignedIn() &&
        ((resource.data.uid == request.auth.uid) || isAdmin());
      allow delete: if isAdmin();
    }

    // ================= Support Tickets =================
    match /Support_Tickets/{ticketId} {
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow read, update: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ================= User Devices =================
    match /User_Devices/{docId} {
      allow read, write: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
    }

    // ================= User Notifications =================
    match /User_Notifications/{notificationId} {
      allow list, get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn() &&
        (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // ================= Chat Sessions =================
    match /chat_sessions/{sessionId} {
      allow read, create, update: if isSignedIn() && (resource.data.ownerUid == request.auth.uid || isAdmin());
      allow delete: if false;

      match /messages/{msgId} {
        allow read, create: if isSignedIn() &&
          (get(/databases/$(database)/documents/chat_sessions/$(sessionId)).data.ownerUid == request.auth.uid || isAdmin());
        allow update, delete: if false;
      }
    }

    // ================= Contact Requests =================
    match /contactRequests/{docId} {
      allow create: if request.resource.data.keys().hasOnly(['fullName','email','phone','message','createdAt','status','service']);
      allow read, update, delete: if false;
    }

    // ================= Quotes =================
    match /quotes/{quoteId} {
      // Read: user can read their own quotes or admin can read all
      allow list, get: if isSignedIn() && (resource.data.userUid == request.auth.uid || isAdmin());

      // Create: only owner can create their quote
      allow create: if isSignedIn() && request.resource.data.userUid == request.auth.uid;

      // Update: admin OR owner may cancel their own quote (narrow field changes only)
      allow update: if isAdmin() || (
        isSignedIn() &&
        resource.data.userUid == request.auth.uid &&
        // Owner may set status to 'Cancelled' and record who/when
        request.resource.data.status == 'Cancelled' &&
        request.resource.data.cancelledByUid == request.auth.uid
      );

      // Delete only admin
      allow delete: if isAdmin();
    }

    // ================= Devices =================
    match /Devices/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // ================= Product Docs =================
    match /product_docs/{docId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isAdmin();
    }

    // ================= Rate Limits =================
    match /rate_limits/{uid} {
      allow read, write: if isCurrentUser(uid) || isAdmin();
    }

    // ================= Support Status / Claims =================
    match /support_status/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /support_claims/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow write: if isAdmin();
    }

    match /support_requests/{uid} {
      allow read: if isCurrentUser(uid) || isAdmin();
      allow create, update: if isCurrentUser(uid);
      allow delete: if isAdmin();
    }
  }
}
