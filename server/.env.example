# Server
PORT=4000
CORS_ORIGIN=http://localhost:4321

# Firebase Admin (Realtime Database)
# You can either paste individual vars below OR point to a JSON file path in FIREBASE_SERVICE_ACCOUNT_JSON.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=your-service-account@your-project-id.iam.gserviceaccount.com
# Note: when pasting the private key, replace actual newlines with \n or wrap in quotes
FIREBASE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nABC...\n-----END PRIVATE KEY-----\n
# Realtime Database URL, e.g. https://your-project-id-default-rtdb.asia-southeast1.firebasedatabase.app
FIREBASE_DB_URL=https://your-project-id-default-rtdb.firebaseio.com
