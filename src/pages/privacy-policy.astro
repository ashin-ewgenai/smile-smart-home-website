---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
---

<Layout title="Privacy Policy - Smile Smart Homes">
  <Navigation />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="bg-gradient-to-br from-teal to-charcoal text-white py-20">
      <div class="container">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Privacy Policy</h1>
        <p class="text-xl text-gray-200">Last Updated: January 2025</p>
      </div>
    </section>

    <!-- Privacy Policy Content -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container max-w-4xl">
        <div class="bg-white dark:bg-gray-800 rounded-lg shadow-lg p-8 md:p-12 space-y-8">
          
          <!-- Introduction -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">1. Introduction</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              Smile Smart Homes ("we," "our," or "us"), operated by <strong>Expectation Walkers GenAI Research and Services Pvt Ltd</strong>, 
              is committed to protecting your privacy and personal data. This Privacy Policy explains how we collect, use, store, and share 
              your personal information when you use our website, services, and smart home installation solutions.
            </p>
            <p class="text-gray-700 dark:text-gray-300">
              This policy complies with applicable data protection laws including India's Digital Personal Data Protection Act (DPDPA) 2023, 
              the General Data Protection Regulation (GDPR), and the California Consumer Privacy Act (CCPA).
            </p>
          </div>

          <!-- Information We Collect -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">2. Information We Collect</h2>
            
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">2.1 Personal Information You Provide</h3>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-4">
              <li><strong>Account Information:</strong> Full name, email address, phone number, password (encrypted), profile picture</li>
              <li><strong>Contact Details:</strong> Mailing address, city, state, country</li>
              <li><strong>Service Requests:</strong> Details about smart home installation requests, service preferences, property information</li>
              <li><strong>Quote Information:</strong> Project details, budget preferences, customization requirements</li>
              <li><strong>Support Tickets:</strong> Issue descriptions, device information, troubleshooting history, chat messages</li>
              <li><strong>Payment Information:</strong> Billing details, transaction history (payment processing handled by third-party providers)</li>
              <li><strong>Device Information:</strong> Smart device details including device names, types, models, serial numbers, installation dates</li>
            </ul>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">2.2 Automatically Collected Information</h3>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-4">
              <li><strong>Authentication Data:</strong> Login timestamps, session information, authentication tokens</li>
              <li><strong>Usage Data:</strong> Pages visited, features used, time spent on platform, interaction patterns</li>
              <li><strong>Device Data:</strong> Browser type, operating system, IP address, device identifiers</li>
              <li><strong>Local Storage:</strong> Browser local storage for session persistence and user preferences</li>
              <li><strong>Rate Limiting Data:</strong> Request timestamps and frequency to prevent abuse</li>
            </ul>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">2.3 Third-Party Services Data</h3>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300">
              <li><strong>Firebase Services:</strong> Authentication, database, cloud storage, cloud functions</li>
              <li><strong>OpenAI API:</strong> Chat messages for AI-powered customer support (processed but not stored by OpenAI)</li>
              <li><strong>reCAPTCHA:</strong> Bot detection and security verification</li>
            </ul>
          </div>

          <!-- How We Use Your Information -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">3. How We Use Your Information</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-3">We use your personal data for the following purposes:</p>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300">
              <li><strong>Service Delivery:</strong> Process installation requests, manage quotes, schedule services, provide customer support</li>
              <li><strong>Account Management:</strong> Create and maintain user accounts, authenticate users, manage preferences</li>
              <li><strong>AI-Powered Support:</strong> Provide intelligent chatbot assistance using OpenAI's GPT models for troubleshooting and support</li>
              <li><strong>Device Management:</strong> Track installed devices, manage warranties, provide device-specific support</li>
              <li><strong>Communication:</strong> Send service updates, notifications, support responses, and important account information</li>
              <li><strong>Analytics:</strong> Improve our services, understand user behavior, optimize platform performance</li>
              <li><strong>Security:</strong> Prevent fraud, detect abuse, enforce rate limits, protect user accounts</li>
              <li><strong>Legal Compliance:</strong> Comply with legal obligations, resolve disputes, enforce our terms</li>
            </ul>
          </div>

          <!-- Data Storage and Security -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">4. Data Storage and Security</h2>
            
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">4.1 Where We Store Your Data</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              Your data is stored using <strong>Google Firebase Cloud Services</strong> (Firestore Database and Cloud Storage) 
              with servers located in the <strong>us-central1</strong> region (United States). Data may be transferred and processed 
              outside of India for service delivery purposes.
            </p>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">4.2 Security Measures</h3>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-4">
              <li>End-to-end encryption for data transmission (HTTPS/TLS)</li>
              <li>Firebase Authentication with secure password hashing</li>
              <li>Role-based access control (user, admin, super admin)</li>
              <li>Firestore security rules to prevent unauthorized access</li>
              <li>Storage security rules for file uploads</li>
              <li>Rate limiting to prevent abuse and DDoS attacks</li>
              <li>Regular security audits and monitoring</li>
              <li>App Check with reCAPTCHA v3 for bot protection</li>
            </ul>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">4.3 Data Retention</h3>
            <p class="text-gray-700 dark:text-gray-300">
              We retain your personal data for as long as necessary to provide our services and comply with legal obligations. 
              Account data is retained while your account is active. Support tickets and chat sessions are retained for 
              customer service quality and legal compliance. You may request deletion of your data at any time (see Section 7).
            </p>
          </div>

          <!-- Data Sharing and Third Parties -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">5. Data Sharing and Third Parties</h2>
            
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">5.1 Third-Party Service Providers</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-3">We share your data with the following trusted third parties:</p>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-4">
              <li><strong>Google Firebase:</strong> Cloud infrastructure, authentication, database, storage, and cloud functions</li>
              <li><strong>OpenAI:</strong> AI-powered chatbot support (chat messages are processed but not used for training per OpenAI's API policy)</li>
              <li><strong>Google reCAPTCHA:</strong> Security and bot detection</li>
              <li><strong>Payment Processors:</strong> Secure payment processing (we do not store credit card information)</li>
            </ul>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">5.2 We Do NOT:</h3>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mb-4">
              <li>Sell your personal data to third parties</li>
              <li>Share your data for marketing purposes without consent</li>
              <li>Use your data for purposes other than those stated in this policy</li>
            </ul>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">5.3 Legal Disclosures</h3>
            <p class="text-gray-700 dark:text-gray-300">
              We may disclose your information if required by law, court order, or government regulation, or to protect 
              our rights, property, or safety, or that of our users.
            </p>
          </div>

          <!-- Cookies and Tracking -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">6. Cookies and Tracking Technologies</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-3">We use the following technologies:</p>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300">
              <li><strong>Browser Local Storage:</strong> Store authentication tokens and user preferences</li>
              <li><strong>Session Storage:</strong> Maintain session state during your visit</li>
              <li><strong>Firebase Analytics:</strong> Track usage patterns and improve our services</li>
              <li><strong>reCAPTCHA Cookies:</strong> Verify human users and prevent bot abuse</li>
            </ul>
            <p class="text-gray-700 dark:text-gray-300 mt-4">
              You can control cookies through your browser settings, but disabling them may affect website functionality.
            </p>
          </div>

          <!-- Your Rights -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">7. Your Privacy Rights</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-3">Under DPDPA, GDPR, and CCPA, you have the following rights:</p>
            
            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">7.1 Access and Portability</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              You have the right to access your personal data and request a copy in a portable format.
            </p>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">7.2 Correction and Update</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              You can update your account information, profile details, and preferences through your dashboard settings.
            </p>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">7.3 Deletion (Right to be Forgotten)</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              You can request deletion of your account and personal data. Contact us at <strong>hello@smilesmarthomes.com</strong> 
              or use the account deletion feature in your dashboard.
            </p>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">7.4 Withdraw Consent</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              You can withdraw consent for data processing at any time by contacting us or adjusting your account settings.
            </p>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">7.5 Object to Processing</h3>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              You can object to certain types of data processing, including marketing communications.
            </p>

            <h3 class="text-xl font-semibold text-gray-900 dark:text-white mb-3">7.6 Lodge a Complaint</h3>
            <p class="text-gray-700 dark:text-gray-300">
              If you believe your privacy rights have been violated, you can file a complaint with:
            </p>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mt-2">
              <li><strong>India:</strong> Data Protection Board of India</li>
              <li><strong>EU:</strong> Your local Data Protection Authority</li>
              <li><strong>California:</strong> California Attorney General's Office</li>
            </ul>
          </div>

          <!-- Children's Privacy -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">8. Children's Privacy</h2>
            <p class="text-gray-700 dark:text-gray-300">
              Our services are not intended for children under 18 years of age. We do not knowingly collect personal 
              information from children. If you believe we have collected data from a child, please contact us immediately.
            </p>
          </div>

          <!-- International Data Transfers -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">9. International Data Transfers</h2>
            <p class="text-gray-700 dark:text-gray-300">
              Your data may be transferred to and processed in countries outside of India, including the United States, 
              where our cloud infrastructure is located. We ensure appropriate safeguards are in place through:
            </p>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mt-3">
              <li>Standard Contractual Clauses with service providers</li>
              <li>Compliance with GDPR adequacy requirements</li>
              <li>Firebase's data protection certifications (ISO 27001, SOC 2, etc.)</li>
            </ul>
          </div>

          <!-- Changes to Privacy Policy -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">10. Changes to This Privacy Policy</h2>
            <p class="text-gray-700 dark:text-gray-300">
              We may update this Privacy Policy from time to time. We will notify you of significant changes by:
            </p>
            <ul class="list-disc list-inside space-y-2 text-gray-700 dark:text-gray-300 mt-3">
              <li>Posting the updated policy on our website with a new "Last Updated" date</li>
              <li>Sending email notifications for material changes</li>
              <li>Displaying in-app notifications</li>
            </ul>
            <p class="text-gray-700 dark:text-gray-300 mt-3">
              Your continued use of our services after changes constitutes acceptance of the updated policy.
            </p>
          </div>

          <!-- Contact Information -->
          <div>
            <h2 class="text-2xl font-bold text-gray-900 dark:text-white mb-4">11. Contact Us</h2>
            <p class="text-gray-700 dark:text-gray-300 mb-4">
              For questions, concerns, or requests regarding this Privacy Policy or your personal data, please contact us:
            </p>
            <div class="bg-gray-50 dark:bg-gray-700 p-6 rounded-lg space-y-2">
              <p class="text-gray-700 dark:text-gray-300"><strong>Company:</strong> Expectation Walkers GenAI Research and Services Pvt Ltd</p>
              <p class="text-gray-700 dark:text-gray-300"><strong>Brand:</strong> Smile Smart Homes</p>
              <p class="text-gray-700 dark:text-gray-300"><strong>Email:</strong> <a href="mailto:hello@smilesmarthomes.com" class="text-teal hover:underline">hello@smilesmarthomes.com</a></p>
              <p class="text-gray-700 dark:text-gray-300"><strong>Phone:</strong> +1 (555) 123-4567</p>
              <p class="text-gray-700 dark:text-gray-300"><strong>WhatsApp:</strong> <a href="https://wa.me/15551234567" class="text-teal hover:underline">Chat on WhatsApp</a></p>
            </div>
          </div>

          <!-- Data Processing Summary -->
          <div class="bg-teal/10 dark:bg-teal/20 p-6 rounded-lg border border-teal/30">
            <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">📋 Quick Summary</h3>
            <ul class="space-y-2 text-gray-700 dark:text-gray-300 text-sm">
              <li>✅ We collect only necessary data to provide our services</li>
              <li>✅ Your data is encrypted and securely stored on Firebase</li>
              <li>✅ We use OpenAI for AI support (messages processed, not stored for training)</li>
              <li>✅ We never sell your personal data</li>
              <li>✅ You can access, update, or delete your data anytime</li>
              <li>✅ We comply with DPDPA, GDPR, and CCPA regulations</li>
            </ul>
          </div>

        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  /* Smooth scroll behavior */
  html {
    scroll-behavior: smooth;
  }

  /* Link styling */
  a {
    transition: all 0.2s ease;
  }

  /* List styling improvements */
  ul li {
    margin-left: 0.5rem;
  }

  /* Responsive spacing */
  @media (max-width: 768px) {
    .section-padding {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }
  }
</style>
