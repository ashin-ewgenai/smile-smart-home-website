---
import Layout from '../../../layouts/Layout.astro';
import DashboardApp from '../../../components/dashboard/User/DashboardApp';
---

<Layout title="About Device - Smile Smart Homes">
  <DashboardApp client:only="react" />
</Layout>

<script>
  // Preserve auth gate
  document.addEventListener('DOMContentLoaded', () => {
    const userEmail = localStorage.getItem('userEmail');
    if (!userEmail) { window.location.href = '/login'; }
  });
</script>
