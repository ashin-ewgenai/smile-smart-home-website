---
import Layout from '../../../layouts/Layout.astro';
import { DashboardLayout } from '../../../components/dashboard/User/DashboardLayout';
---

<Layout title="About Device - Smile Smart Homes">
  <DashboardLayout userType="user" userName="User" client:load>
    <section class="p-6">
      <div class="mb-6 flex flex-col sm:flex-row sm:items-end sm:justify-between gap-4">
        <div>
          <h1 class="text-2xl font-semibold text-charcoal dark:text-white">my devices</h1>
          <p class="text-sm text-gray-600 dark:text-gray-400">Informational-only view of your smart devices</p>
        </div>
        <div class="flex flex-wrap items-center gap-3">
          <label class="relative">
            <input id="searchInput" type="text" placeholder="Search devices..." class="pl-9 pr-3 py-2 w-64 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500" />
            <span class="pointer-events-none absolute left-2 top-1/2 -translate-y-1/2 text-gray-400">🔎</span>
          </label>
          <select id="roomFilter" class="px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500">
            <option value="all">All Rooms</option>
          </select>
          <select id="typeFilter" class="px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500">
            <option value="all">All Types</option>
          </select>
          <select id="statusFilter" class="px-3 py-2 rounded-md border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500">
            <option value="all">All Status</option>
            <option value="installed">Installed</option>
            <option value="pending">Pending</option>
            <option value="maintenance">Maintenance</option>
          </select>
          <label class="inline-flex items-center gap-2 text-sm text-gray-700 dark:text-gray-300 select-none">
            <input id="groupByRoom" type="checkbox" class="rounded border-gray-300 dark:border-gray-600 text-teal-600 focus:ring-teal-500" />
            Group by room
          </label>
        </div>
      </div>

      <!-- Room overview chips -->
      <div id="roomOverview" class="mb-5 flex flex-wrap gap-2"></div>

      <!-- Devices list -->
      <div id="devicesContainer" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>

      <!-- Add More Devices -->
      <div class="mt-10">
        <h2 class="text-xl font-semibold text-charcoal dark:text-white">Add More Devices</h2>
        <p class="text-sm text-gray-600 dark:text-gray-400">Explore and add new smart devices available for your home.</p>
        <div id="availableDevices" class="mt-4 grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4"></div>
      </div>

      <!-- Details Modal -->
      <div id="detailsBackdrop" class="hidden fixed inset-0 z-50 bg-black/50 p-4 flex items-center justify-center">
        <div class="relative w-full max-w-2xl">
          <div class="bg-white dark:bg-gray-800 rounded-lg shadow-2xl border border-gray-200 dark:border-gray-700 overflow-hidden">
            <div class="px-5 py-3 border-b border-gray-200 dark:border-gray-700 flex justify-between items-center">
              <h3 class="text-base font-semibold text-gray-900 dark:text-white">Device Details</h3>
              <button id="detailsClose" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-md border border-gray-300 dark:border-gray-600 text-gray-700 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700">Close</button>
            </div>
            <div id="detailsScroll" class="max-h-[70vh] overflow-y-auto overscroll-contain touch-pan-y px-5 py-4 text-sm text-gray-800 dark:text-gray-200"></div>
          </div>
        </div>
      </div>
    </section>
  </DashboardLayout>
</Layout>

<script type="module">
  // Simple, self-contained devices UI with client-side state
  document.addEventListener('DOMContentLoaded', () => {
    // Auth gate
    const userEmail = localStorage.getItem('userEmail');
    if (!userEmail) { window.location.href = '/login'; return; }

    // DOM refs
    const searchInput = document.getElementById('searchInput');
    const roomFilter = document.getElementById('roomFilter');
    const typeFilter = document.getElementById('typeFilter');
    const statusFilter = document.getElementById('statusFilter');
    const groupByRoom = document.getElementById('groupByRoom');
    const devicesContainer = document.getElementById('devicesContainer');
    const roomOverview = document.getElementById('roomOverview');
    const detailsBackdrop = document.getElementById('detailsBackdrop');
    const detailsClose = document.getElementById('detailsClose');
    const detailsScroll = document.getElementById('detailsScroll');

    // Prevent background scroll when details open
    function lockBody(lock) {
      document.body.style.overflow = lock ? 'hidden' : '';
    }
    detailsBackdrop.addEventListener('wheel', e => e.stopPropagation());
    detailsBackdrop.addEventListener('touchmove', e => e.stopPropagation());

    // Demo dataset (replace with real data if available)
    let devices = [
      { id: 'd1', name: 'Living Room Camera', type: 'Camera', brand: 'AcmeCam X2', room: 'Living Room', status: 'installed', lastSeen: 'Just now', model: 'X2', installedAt: '2024-09-12', fw: '2.1.4', mac: '00:1A:7D:9B:00:01', ip: '192.168.1.21', protocol: 'Wi‑Fi', linked: 'Google Home', serial: 'CAMX2-001-ABCD', notes: 'Watching the front door', support: 'https://example.com/cam/support', manual: '#', faq: '#' },
      { id: 'd2', name: 'Front Door Lock', type: 'Smart Lock', brand: 'SecureLock Pro', room: 'Entrance', status: 'maintenance', lastSeen: '2 min ago', model: 'SL-Pro', installedAt: '2024-08-03', fw: '5.8.0', mac: '00:1A:7D:9B:00:02', ip: '192.168.1.34', protocol: 'Zigbee', linked: 'Alexa', serial: 'SLP-2233-XY', notes: 'Auto-lock at night', support: '#', manual: '#', faq: '#' },
      { id: 'd3', name: 'Bedroom Light', type: 'Smart Bulb', brand: 'BrightLite', room: 'Bedroom', status: 'maintenance', lastSeen: '3 hrs ago', model: 'BL-Color', installedAt: '2024-11-20', fw: '1.0.9', mac: '00:1A:7D:9B:00:03', ip: '192.168.1.45', protocol: 'Zigbee', linked: 'Google Home', serial: 'BL-C-9902', notes: '', support: '#', manual: '#', faq: '#' },
      { id: 'd4', name: 'Kitchen Thermostat', type: 'Thermostat', brand: 'ThermoMax', room: 'Kitchen', status: 'installed', lastSeen: '—', model: 'TX-10', installedAt: '2025-01-05', fw: '3.4.2', mac: '00:1A:7D:9B:00:04', ip: '192.168.1.52', protocol: 'Wi‑Fi', linked: 'IFTTT', serial: 'TX10-A1', notes: 'Schedule @ 7am/7pm', support: '#', manual: '#', faq: '#' },
      { id: 'd5', name: 'Garage Door Sensor', type: 'Sensor', brand: 'SenseIt', room: 'Garage', status: 'pending', lastSeen: '—', model: 'SEN-M', installedAt: '2024-10-01', fw: '0.9.2', mac: '00:1A:7D:9B:00:05', ip: '192.168.1.88', protocol: 'BLE', linked: '-', serial: 'SNS-009', notes: 'Pending pairing', support: '#', manual: '#', faq: '#' },
    ];

    // Available devices from admin side (not yet installed)
    let available = [
      { id: 'a1', name: 'Outdoor Camera', type: 'Camera', model: 'Cam-Outdoor X', desc: 'Weatherproof camera with night vision and motion alerts.' },
      { id: 'a2', name: 'Smart Plug', type: 'Outlet', model: 'Plug Mini', desc: 'Control any appliance remotely and monitor energy usage.' },
      { id: 'a3', name: 'Air Quality Sensor', type: 'Sensor', model: 'AQ-200', desc: 'Tracks PM2.5, CO₂ and humidity with realtime alerts.' },
      { id: 'a4', name: 'Smart Doorbell', type: 'Doorbell', model: 'Ring-X', desc: 'HD video doorbell with two-way audio and motion detection.' }
    ];

    const typeIcon = (t) => ({
      'Camera': '📷', 'Smart Lock': '🔒', 'Smart Bulb': '💡', 'Thermostat': '🌡️', 'Sensor': '📟'
    }[t] || '🔧');

    // Populate filter selects from data
    function populateFilters() {
      const rooms = Array.from(new Set(devices.map(d => d.room))).sort();
      const types = Array.from(new Set(devices.map(d => d.type))).sort();
      roomFilter.innerHTML = '<option value="all">All Rooms</option>' + rooms.map(r => `<option>${r}</option>`).join('');
      typeFilter.innerHTML = '<option value="all">All Types</option>' + types.map(t => `<option>${t}</option>`).join('');
    }

    function statusBadge(s) {
      const label = {
        installed: 'installed',
        pending: 'pending',
        maintenance: 'maintenance'
      }[s] || s;
      const map = {
        installed: 'bg-blue-100 text-blue-800 dark:bg-blue-900/30 dark:text-blue-200',
        pending: 'bg-amber-100 text-amber-800 dark:bg-amber-900/30 dark:text-amber-300',
        maintenance: 'bg-violet-100 text-violet-800 dark:bg-violet-900/30 dark:text-violet-300'
      };
      const dot = {
        installed: 'bg-blue-500',
        pending: 'bg-amber-500',
        maintenance: 'bg-violet-500'
      }[s] || 'bg-gray-400';
      return `<span class="inline-flex items-center gap-1.5 px-2 py-0.5 rounded-full text-xs font-medium ${map[s] || 'bg-gray-100 text-gray-800 dark:bg-gray-700 dark:text-gray-200'}"><span class=\"h-1.5 w-1.5 rounded-full ${dot}\"></span>${label}</span>`;
    }

    function renderRoomOverview(list) {
      const byRoom = list.reduce((acc, d) => { acc[d.room] = (acc[d.room]||0)+1; return acc; }, {});
      const selected = roomFilter.value;
      const chips = [];
      // All chip first
      const allActive = selected === 'all';
      chips.push(`
        <span data-room="__all__" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-sm cursor-pointer ${allActive ? 'bg-teal text-white border-teal hover:opacity-90' : 'border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700'}">
          <strong class="font-semibold">All</strong>
          <span class="${allActive ? 'text-white/80' : 'text-gray-500'}">${list.length}</span>
        </span>
      `);
      chips.push(...Object.entries(byRoom).map(([room,count]) => {
        const active = selected===room;
        return `
          <span data-room="${room}" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border text-sm cursor-pointer ${active ? 'bg-teal text-white border-teal hover:opacity-90' : 'border-gray-300 dark:border-gray-600 text-gray-800 dark:text-gray-200 hover:bg-gray-100 dark:hover:bg-gray-700'}">
            <strong class="font-semibold">${room}</strong>
            <span class="${active ? 'text-white/80' : 'text-gray-500'}">${count}</span>
          </span>
        `;
      }));
      roomOverview.innerHTML = chips.join('');
    }

    function deviceCard(d) {
      return `
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 p-4 flex flex-col gap-3">
        <div class="flex items-start justify-between">
          <div class="flex items-center gap-3">
            <div class="h-10 w-10 flex items-center justify-center text-lg">${typeIcon(d.type)}</div>
            <div>
              <div class="text-sm font-semibold text-gray-900 dark:text-white">${d.name}</div>
              <div class="text-xs text-gray-600 dark:text-gray-400">${d.type} • ${d.brand}</div>
            </div>
          </div>
          ${statusBadge(d.status)}
        </div>
        <div class="text-xs text-gray-600 dark:text-gray-400 flex flex-wrap gap-3">
          <span>Room: <span class="text-gray-800 dark:text-gray-200">${d.room}</span></span>
          <span>Model: <span class="text-gray-800 dark:text-gray-200">${d.model}</span></span>
        </div>
        <div class="mt-1 flex items-center gap-2">
          <button data-action="details" data-id="${d.id}" class="px-3 py-1.5 text-sm rounded-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">View Details</button>
        </div>
      </div>`;
    }

    function availableCard(d) {
      return `
      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 p-4 flex flex-col gap-3 hover:shadow-lg transition-shadow">
        <div class="flex items-start justify-between">
          <div>
            <div class="text-sm font-semibold text-gray-900 dark:text-white">${d.name}</div>
            <div class="text-xs text-gray-600 dark:text-gray-400">${d.type} • Model: ${d.model}</div>
          </div>
        </div>
        <p class="text-sm text-gray-700 dark:text-gray-300 line-clamp-2">${d.desc}</p>
        <div class="mt-1 flex items-center gap-2">
          <button data-action="add" data-id="${d.id}" class="px-3 py-1.5 text-sm rounded-md border border-teal-500 bg-teal-600 text-white hover:bg-teal-700 focus:ring-2 focus:ring-teal-500">Add Device</button>
        </div>
      </div>`;
    }

    function matches(d, query, room, type, status) {
      const q = query.trim().toLowerCase();
      const text = `${d.name} ${d.type} ${d.brand} ${d.model} ${d.room}`.toLowerCase();
      return (!q || text.includes(q)) &&
             (room==='all' || d.room===room) &&
             (type==='all' || d.type===type) &&
             (status==='all' || d.status===status);
    }

    function render() {
      const q = searchInput.value || '';
      const room = roomFilter.value;
      const type = typeFilter.value;
      const status = statusFilter.value;
      const group = groupByRoom.checked;
      const filtered = devices.filter(d => matches(d, q, room, type, status));
      // Show all room chips regardless of current filters
      renderRoomOverview(devices);

      if (!group) {
        devicesContainer.innerHTML = filtered.map(deviceCard).join('');
      } else {
        // Group by room
        const by = filtered.reduce((acc, d) => { (acc[d.room] = acc[d.room] || []).push(d); return acc; }, {});
        devicesContainer.innerHTML = Object.keys(by).sort().map(room => `
          <div class="md:col-span-2 xl:col-span-3">
            <div class="flex items-center justify-between mb-2">
              <h3 class="text-sm font-semibold text-gray-900 dark:text-white">${room}</h3>
              <span class="text-xs text-gray-500">${by[room].length} device(s)</span>
            </div>
            <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4">${by[room].map(deviceCard).join('')}</div>
          </div>
        `).join('');
      }
    }

    function renderAvailable() {
      const wrap = document.getElementById('availableDevices');
      if (!wrap) return;
      wrap.innerHTML = available.map(availableCard).join('');
    }

    function openDetails(d) {
      const info = `
        <dl class="grid grid-cols-1 sm:grid-cols-2 gap-x-6 gap-y-3">
          <div><dt class="text-gray-500 dark:text-gray-400">Device</dt><dd class="text-gray-900 dark:text-white">${d.name}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Type</dt><dd>${d.type}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Brand/Model</dt><dd>${d.brand} / ${d.model}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Room</dt><dd>${d.room}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Status</dt><dd>${d.status}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Installed</dt><dd>${d.installedAt}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Firmware</dt><dd>${d.fw}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Network</dt><dd>MAC ${d.mac} • IP ${d.ip} • ${d.protocol}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Linked Services</dt><dd>${d.linked}</dd></div>
          <div><dt class="text-gray-500 dark:text-gray-400">Serial/QR</dt><dd>${d.serial}</dd></div>
          <div class="sm:col-span-2"><dt class="text-gray-500 dark:text-gray-400">Notes</dt><dd>${d.notes || '—'}</dd></div>
        </dl>
        <div class="mt-4">
          <h4 class="text-sm font-semibold text-gray-900 dark:text-white mb-1">Support & Docs</h4>
          <div class="flex flex-wrap gap-2 text-sm">
            <a href="${d.support}" target="_blank" class="px-3 py-1.5 rounded-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">Manufacturer</a>
            <a href="${d.manual}" target="_blank" class="px-3 py-1.5 rounded-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">User Manual</a>
            <a href="${d.faq}" target="_blank" class="px-3 py-1.5 rounded-md border border-gray-300 dark:border-gray-600 hover:bg-gray-100 dark:hover:bg-gray-700">Troubleshooting</a>
          </div>
        </div>
      `;
      detailsScroll.innerHTML = info;
      detailsBackdrop.classList.remove('hidden');
      lockBody(true);
    }

    function closeDetails() {
      detailsBackdrop.classList.add('hidden');
      lockBody(false);
    }

    // Wire events
    searchInput.addEventListener('input', render);
    roomFilter.addEventListener('change', render);
    typeFilter.addEventListener('change', render);
    statusFilter.addEventListener('change', render);
    groupByRoom.addEventListener('change', render);
    detailsClose.addEventListener('click', closeDetails);
    detailsBackdrop.addEventListener('click', (e) => { if (e.target === detailsBackdrop) closeDetails(); });

    // Click a room chip to filter the room select
    roomOverview.addEventListener('click', (e) => {
      const chip = e.target.closest('[data-room]');
      if (!chip) return;
      const room = chip.getAttribute('data-room');
      // set select value if option exists; else fallback to 'all'
      if (room === '__all__') {
        roomFilter.value = 'all';
      } else {
        const optionExists = Array.from(roomFilter.options).some(o => o.value === room || o.text === room);
        roomFilter.value = optionExists ? room : 'all';
      }
      render();
    });

    devicesContainer.addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      const action = btn.getAttribute('data-action');
      const item = devices.find(d => d.id === id);
      if (!item) return;
      if (action === 'details') {
        openDetails(item);
      }
    });

    // Handle Add Device buttons
    document.getElementById('availableDevices').addEventListener('click', (e) => {
      const btn = e.target.closest('button');
      if (!btn) return;
      const id = btn.getAttribute('data-id');
      const d = available.find(x => x.id === id);
      if (!d) return;
      // For demo: move from available -> devices as pending
      available = available.filter(x => x.id !== id);
      devices.push({ id: `new-${id}`, name: d.name, type: d.type, brand: '-', room: '-', status: 'pending', lastSeen: '—', model: d.model, fw: '-', mac: '-', ip: '-', protocol: '-', linked: '-', serial: '-', notes: d.desc });
      render();
      renderAvailable();
    });

    // Init
    populateFilters();
    render();
    renderAvailable();
  });
</script>
