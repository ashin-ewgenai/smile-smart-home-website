---
import Layout from '../../../layouts/Layout.astro';
import { DashboardLayout } from '../../../components/dashboard/User/DashboardLayout';
import QuoteForm from '../../../components/dashboard/User/QuoteForm';
---

<Layout title="Quote Portal - Smile Smart Homes">
  <DashboardLayout userType="user" userName="User" client:load>
    <section class="p-6">
      <h1 class="text-2xl font-semibold text-charcoal dark:text-white mb-2">Quote Portal</h1>
      <p class="text-gray-700 dark:text-gray-300 mb-6">Fill the form to request a quote.</p>

      <QuoteForm client:load />
    </section>
  </DashboardLayout>
</Layout>

<!-- Script removed: handled by React component -->
