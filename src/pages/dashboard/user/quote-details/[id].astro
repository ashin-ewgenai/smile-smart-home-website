---
import QuoteDetails from '@/components/dashboard/User/QuoteDetails';
import Layout from '@/layouts/Layout.astro';

const { id } = Astro.params as { id?: string };
export async function getStaticPaths() { return []; }
---

<Layout title="Quote Details">
  <main>
    {id ? <QuoteDetails quoteId={id} client:load /> : null}
  </main>
</Layout>
