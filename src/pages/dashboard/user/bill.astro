---
import Layout from '../../../layouts/Layout.astro';
import { DashboardLayout } from '../../../components/dashboard/User/DashboardLayout';
---

<Layout title="Bill - Smile Smart Homes">
  <DashboardLayout userType="user" userName="User" client:load>
    <section class="p-6">
      <h1 class="text-2xl font-semibold text-charcoal dark:text-white mb-4">Bill</h1>
      <p class="text-gray-700 dark:text-gray-300">This is a placeholder page. Show billing history or details here.</p>
    </section>
  </DashboardLayout>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const userEmail = localStorage.getItem('userEmail');
    if (!userEmail) window.location.href = '/login';
  });
</script>
