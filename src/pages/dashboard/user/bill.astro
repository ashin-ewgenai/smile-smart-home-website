---
import Layout from '../../../layouts/Layout.astro';
import { DashboardLayout } from '../../../components/dashboard/User/DashboardLayout';
---

<Layout title="Bill - Smile Smart Homes">
  <DashboardLayout userType="user" userName="User" client:load>
    <section class="p-6 space-y-6">
      <div class="flex items-center justify-between">
        <h1 class="text-3xl font-extrabold tracking-tight text-charcoal dark:text-white">Billing Details</h1>
      </div>

      {/* Current Package / Service */}
      <div class="bg-white/80 dark:bg-gray-800/80 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-lg p-5">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-sky-400"><path d="M3.75 6A2.25 2.25 0 016 3.75h12A2.25 2.25 0 0120.25 6v12A2.25 2.25 0 0118 20.25H6A2.25 2.25 0 013.75 18V6z"/></svg>
          Current Package / Service
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 text-sm">
          <div><div class="text-gray-500 dark:text-gray-400">Name</div><div id="curr-name" class="text-gray-900 dark:text-gray-100">Smart Home Plus</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Start Date</div><div id="curr-start" class="text-gray-900 dark:text-gray-100">2025-01-01</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Billing Cycle</div><div id="curr-cycle" class="text-gray-900 dark:text-gray-100">Monthly</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Price</div><div id="curr-price" class="text-gray-900 dark:text-gray-100">$29.99</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Next Billing Date</div><div id="curr-next" class="text-gray-900 dark:text-gray-100">2025-09-05</div></div>
        </div>
      </div>

      {/* Due Bill Summary */}
      <div class="bg-white/80 dark:bg-gray-800/80 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-lg p-5">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-teal-400"><path d="M12 1.5a10.5 10.5 0 100 21 10.5 10.5 0 000-21zm.75 5.25a.75.75 0 00-1.5 0v5.25c0 .199.079.39.22.53l3.75 3.75a.75.75 0 101.06-1.06l-3.53-3.53V6.75z"/></svg>
          Due Bill Summary
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
          <div><div class="text-gray-500 dark:text-gray-400">For</div><div id="due-for" class="text-gray-900 dark:text-gray-100">Smart Home Plus (Monthly)</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Total Amount Due</div><div id="due-total" class="text-emerald-600 dark:text-emerald-300 font-semibold">$19.99</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Due Date</div><div id="due-date" class="text-gray-900 dark:text-gray-100">2025-09-05</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Late Fees</div><div id="due-fee" class="text-gray-900 dark:text-gray-100">$0.00</div></div>
        </div>
        
      </div>

      {/* Other Packages / Services Subscribed */}
      <div class="bg-white/80 dark:bg-gray-800/80 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-lg p-5">
        <div class="flex items-center justify-between mb-3">
          <h2 class="text-lg font-semibold text-gray-900 dark:text-white flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-indigo-400"><path d="M4.5 6.75A2.25 2.25 0 016.75 4.5h10.5A2.25 2.25 0 0119.5 6.75v10.5A2.25 2.25 0 0117.25 19.5H6.75A2.25 2.25 0 014.5 17.25V6.75z"/></svg>
            Other Packages / Services Subscribed
          </h2>
        </div>
        <ul id="other-services" class="divide-y divide-gray-200 dark:divide-gray-700 text-sm">
          <li class="py-2 flex items-center justify-between">
            <span>Warranty Plan</span>
            <span class="text-gray-500 dark:text-gray-400">$79.00/yr – Active</span>
          </li>
          <li class="py-2 flex items-center justify-between">
            <span>TV Add-on</span>
            <span class="text-gray-500 dark:text-gray-400">$9.99/mo – Paused</span>
          </li>
        </ul>
      </div>

      {/* Installment Breakdown */}
      <div class="bg-white/80 dark:bg-gray-800/80 border border-gray-200 dark:border-gray-700 rounded-2xl shadow-lg p-5">
        <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3 flex items-center gap-2">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5 text-emerald-400"><path d="M12 2.25A9.75 9.75 0 112.25 12 9.761 9.761 0 0112 2.25z"/></svg>
          Installment Breakdown
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
          <div><div class="text-gray-500 dark:text-gray-400">For</div><div id="ins-item" class="text-gray-900 dark:text-gray-100">Warranty Plan</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Total Installments</div><div id="ins-total" class="text-gray-900 dark:text-gray-100">6</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Installment Amount</div><div id="ins-amount" class="text-gray-900 dark:text-gray-100">$49.00</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Paid</div><div id="ins-paid" class="text-gray-900 dark:text-gray-100">2 of 6 Installments Paid</div></div>
          <div><div class="text-gray-500 dark:text-gray-400">Next Installment Due</div><div id="ins-next" class="text-gray-900 dark:text-gray-100">$49.00 on 2025-09-20</div></div>
        </div>
        <div class="mt-4">
          <div class="h-2 w-full rounded-full bg-gray-700/60 overflow-hidden">
            <div id="ins-progress-fill" class="h-full bg-emerald-500" style="width: 33%"></div>
          </div>
          <div id="ins-progress-label" class="mt-2 text-xs text-gray-400">33% paid (2 of 6)</div>
        </div>
      </div>

      
    </section>
  </DashboardLayout>
</Layout>

<script type="module">
  document.addEventListener('DOMContentLoaded', () => {
    const userEmail = localStorage.getItem('userEmail');
    if (!userEmail) window.location.href = '/login';

    // Simple name extraction for header
    const name = userEmail ? userEmail.split('@')[0] : 'Customer';
    const capName = name.charAt(0).toUpperCase() + name.slice(1);
    const nameEl = document.getElementById('bill-customer-name');
    if (nameEl) nameEl.textContent = capName;
    
    // Optional: Seed the placeholders with sample values for demo
    const set = (id, v) => { const el = document.getElementById(id); if (el) el.textContent = v; };
    set('curr-name', 'Smart Home Plus');
    set('curr-start', '2025-01-01');
    set('curr-cycle', 'Monthly');
    set('curr-price', '$29.99');
    set('curr-next', '2025-09-05');

    set('due-for', 'Smart Home Plus (Monthly)');
    set('due-total', '$19.99');
    set('due-date', '2025-09-05');
    set('due-fee', '$0.00');
    set('due-status', 'Awaiting Payment');

    const other = document.getElementById('other-services');
    if (other) {
      other.innerHTML = ''+
        '<li class="py-2 flex items-center justify-between">'+
          '<span class="flex items-center gap-2">'+
            '<span>Warranty Plan</span>'+ 
            '<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-emerald-900/30 text-emerald-300 border border-emerald-700/50">Active</span>'+
          '</span>'+
          '<span class="text-right">'+
            '<div class="text-gray-300">$79.00/yr</div>'+
            '<div class="text-[11px] text-gray-500">Charged on 2025-06-01 • Ends 2026-05-31</div>'+
          '</span>'+
        '</li>'+
        '<li class="py-2 flex items-center justify-between">'+
          '<span class="flex items-center gap-2">'+
            '<span>TV Add-on</span>'+ 
            '<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium bg-amber-900/30 text-amber-300 border border-amber-700/50">Paused</span>'+
          '</span>'+
          '<span class="text-right">'+
            '<div class="text-gray-300">$9.99/mo</div>'+
            '<div class="text-[11px] text-gray-500">Charged on 2025-08-05 • Ends 2025-09-04</div>'+
          '</span>'+
        '</li>';
    }

    set('ins-item', 'Warranty Plan');
    set('ins-total', '6');
    set('ins-amount', '$49.00');
    set('ins-paid', '2 of 6 Installments Paid');
    set('ins-next', '$49.00 on 2025-09-20');

    // Compute and render installment progress
    const total = parseInt(document.getElementById('ins-total')?.textContent || '0', 10);
    const paidText = document.getElementById('ins-paid')?.textContent || '';
    const paidMatch = paidText.match(/^(\d+)\s+of\s+(\d+)/i);
    const paid = paidMatch ? parseInt(paidMatch[1], 10) : 0;
    const pct = total > 0 ? Math.min(100, Math.round((paid / total) * 100)) : 0;
    const fill = document.getElementById('ins-progress-fill');
    const label = document.getElementById('ins-progress-label');
    if (fill) fill.style.width = pct + '%';
    if (label) label.textContent = `${pct}% paid (${paid} of ${total})`;
  });
</script>
