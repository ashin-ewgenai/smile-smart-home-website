---
import Layout from '../../../../layouts/Layout.astro';
import { DashboardLayout } from '../../../../components/dashboard/Admin/DashboardLayout';
import DeviceForm from '../../../../components/dashboard/Admin/DeviceForm';
---

<Layout title="Add Device - Admin Dashboard | Smile Smart Homes">
  <DashboardLayout userType="admin" userName="Admin" client:load>
    <div class="max-w-3xl mx-auto">
      <div class="mb-6">
        <h1 class="text-2xl font-bold text-gray-900 dark:text-white">Add Device</h1>
        <p class="text-gray-600 dark:text-gray-400">Register a new device to the system.</p>
      </div>

      <div class="bg-white dark:bg-gray-800 rounded-lg shadow-md border border-gray-200 dark:border-gray-700 p-6">
        <DeviceForm client:load />
      </div>
    </div>
  </DashboardLayout>
</Layout>

<!-- DeviceForm handles auth context and submission to Firestore. -->
