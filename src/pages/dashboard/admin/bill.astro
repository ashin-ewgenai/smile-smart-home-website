---
import Layout from '../../../layouts/Layout.astro';
import { DashboardLayout } from '../../../components/dashboard/Admin/DashboardLayout';
---

<Layout title="Bill (Admin) - Smile Smart Homes">
  <DashboardLayout userType="admin" userName="Admin" client:load>
    <section class="p-6">
      <h1 class="text-2xl font-semibold text-charcoal dark:text-white mb-4">Bill (Admin)</h1>
      <p class="text-gray-700 dark:text-gray-300">Admin view placeholder for billing and invoices.</p>
    </section>
  </DashboardLayout>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const userEmail = localStorage.getItem('userEmail');
    if (!userEmail) window.location.href = '/login';
  });
</script>
