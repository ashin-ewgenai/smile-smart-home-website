---
import Layout from '../../../layouts/Layout.astro';
import { DashboardLayout } from '../../../components/dashboard/Admin/DashboardLayout';
---

<Layout title="Devices - Admin">
  <DashboardLayout userType="admin" userName="Admin" client:load>
    <section class="bg-white dark:bg-gray-800 rounded-lg shadow-md p-6 border border-gray-200 dark:border-gray-700">
      <div class="flex items-center justify-between mb-4">
        <h1 class="text-xl font-semibold text-gray-900 dark:text-white">Devices</h1>
        <div class="flex gap-2">
          <a href="/dashboard/admin/devices/add" class="inline-flex items-center gap-2 px-3 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded">
            <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor" class="w-4 h-4">
              <path fill-rule="evenodd" d="M10 5a1 1 0 011 1v3h3a1 1 0 110 2h-3v3a1 1 0 11-2 0v-3H6a1 1 0 110-2h3V6a1 1 0 011-1z" clip-rule="evenodd" />
            </svg>
            <span>Add Device</span>
          </a>
        </div>
      </div>
      <!-- Filter info banner (hidden by default, shown when userEmail filter is active) -->
      <div id="filterInfo" class="mb-4 hidden">
        <div class="flex items-center justify-between rounded-md border border-teal-200 dark:border-teal-800 bg-teal-50 dark:bg-teal-900/20 px-4 py-2 text-sm text-teal-800 dark:text-teal-200">
          <div>
            <span class="font-medium">Filtering by user:</span>
            <span id="filterEmailText" class="ml-1"></span>
          </div>
          <a href="/dashboard/admin/devices" class="underline text-teal-700 dark:text-teal-300 hover:text-teal-900">Clear</a>
        </div>
      </div>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200 dark:divide-gray-700">
          <thead class="bg-gray-50 dark:bg-gray-700">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Name</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Type</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Location</th>
              <th class="px-6 py-3 text-left text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Status</th>
              <th class="px-6 py-3 text-right text-xs font-medium text-gray-500 dark:text-gray-300 uppercase tracking-wider">Actions</th>
            </tr>
          </thead>
          <tbody class="bg-white dark:bg-gray-800 divide-y divide-gray-200 dark:divide-gray-700" id="devicesBody"></tbody>
        </table>
      </div>
    </section>
  </DashboardLayout>
</Layout>

<!-- Edit Device Modal -->
<div id="deviceModal" class="fixed inset-0 z-50 hidden items-center justify-center">
  <div class="absolute inset-0 bg-black/50"></div>
  <div class="relative bg-white dark:bg-gray-800 rounded-lg shadow-lg w-full max-w-lg mx-4 p-6 border border-gray-200 dark:border-gray-700">
    <h2 id="modalTitle" class="text-lg font-semibold text-gray-900 dark:text-white mb-4">Edit Device</h2>
    <form id="deviceForm" class="space-y-4">
      <input type="hidden" id="editIndex" value="" />
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Name</label>
          <input id="devName" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500" required />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Type</label>
          <select id="devType" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500">
            <option>Camera</option>
            <option>Sensor</option>
            <option>Lock</option>
            <option>Thermostat</option>
            <option>Light</option>
          </select>
        </div>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Location</label>
          <input id="devLocation" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500" />
        </div>
        <div>
          <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Status</label>
          <select id="devStatus" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal-500">
            <option>Active</option>
            <option>Inactive</option>
          </select>
        </div>
      </div>
      <div class="flex items-center justify-end gap-2 pt-2">
        <button type="button" id="cancelModal" class="px-4 py-2 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded border border-gray-300 dark:border-gray-600">Cancel</button>
        <button type="submit" class="px-4 py-2 bg-teal-600 hover:bg-teal-700 text-white rounded">Save</button>
      </div>
    </form>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // Admin guard
    const userEmail = localStorage.getItem('userEmail');
    const userRole = localStorage.getItem('userRole');
    const isAdmin = userRole === 'admin';
    if (!userEmail || !isAdmin) {
      window.location.href = '/admin_login';
      return;
    }

    type Device = { name: string; type: string; location?: string; status: 'Active' | 'Inactive' };
    const STORAGE_KEY = 'adminDevices';
    const USER_DEVICES_KEY = 'adminUserDevicesMap';
    const tbody = document.getElementById('devicesBody') as HTMLTableSectionElement | null;
    const modal = document.getElementById('deviceModal') as HTMLDivElement | null;
    const cancelBtn = document.getElementById('cancelModal') as HTMLButtonElement | null;
    const form = document.getElementById('deviceForm') as HTMLFormElement | null;
    const editIndexInput = document.getElementById('editIndex') as HTMLInputElement | null;
    const nameInput = document.getElementById('devName') as HTMLInputElement | null;
    const typeInput = document.getElementById('devType') as HTMLSelectElement | null;
    const locInput = document.getElementById('devLocation') as HTMLInputElement | null;
    const statusInput = document.getElementById('devStatus') as HTMLSelectElement | null;
    const filterInfo = document.getElementById('filterInfo') as HTMLDivElement | null;
    const filterEmailText = document.getElementById('filterEmailText') as HTMLSpanElement | null;

    const defaultDevices: Device[] = [
      { name: 'Living Room Camera', type: 'Camera', location: 'Living Room', status: 'Active' },
      { name: 'Front Door Lock', type: 'Lock', location: 'Entrance', status: 'Active' },
      { name: 'Kitchen Smoke Sensor', type: 'Sensor', location: 'Kitchen', status: 'Inactive' },
      { name: 'Hallway Thermostat', type: 'Thermostat', location: 'Hallway', status: 'Active' },
      { name: 'Porch Light', type: 'Light', location: 'Porch', status: 'Active' },
    ];

    function loadDevices(): Device[] {
      try {
        const raw = localStorage.getItem(STORAGE_KEY);
        if (!raw) return defaultDevices;
        const parsed = JSON.parse(raw);
        if (Array.isArray(parsed)) return parsed as Device[];
        return defaultDevices;
      } catch (e) {
        return defaultDevices;
      }
    }

    function saveDevices(devs: Device[]) {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(devs));
    }

    function loadUserDevicesMap(): Record<string, string[]> {
      try {
        const raw = localStorage.getItem(USER_DEVICES_KEY);
        if (!raw) return {};
        const parsed = JSON.parse(raw);
        return parsed && typeof parsed === 'object' ? (parsed as Record<string, string[]>) : {};
      } catch {
        return {};
      }
    }

    function openModal(index: number, dev: Device) {
      if (!modal || !editIndexInput || !nameInput || !typeInput || !locInput || !statusInput) return;
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      editIndexInput.value = String(index);
      nameInput.value = dev.name || '';
      typeInput.value = dev.type || 'Camera';
      locInput.value = dev.location || '';
      statusInput.value = dev.status || 'Active';
    }

    function closeModal() {
      if (!modal || !form || !editIndexInput) return;
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      form.reset();
      editIndexInput.value = '';
    }

    function render() {
      const allDevs = loadDevices();
      // parse filter
      const params = new URLSearchParams(window.location.search);
      const filterEmailParam = params.get('userEmail');
      const activeFilterEmail = filterEmailParam ? decodeURIComponent(filterEmailParam).toLowerCase() : null;

      let devs = allDevs;
      if (activeFilterEmail) {
        const map = loadUserDevicesMap();
        const names = new Set((map[activeFilterEmail] || []));
        devs = allDevs.filter(d => names.has(d.name));
        if (filterInfo && filterEmailText) {
          filterEmailText.textContent = filterEmailParam || '';
          filterInfo.classList.remove('hidden');
        }
      } else if (filterInfo) {
        filterInfo.classList.add('hidden');
      }
      if (!tbody) return;
      tbody.innerHTML = devs.length === 0
        ? `<tr><td colspan="5" class="px-6 py-6 text-center text-sm text-gray-500 dark:text-gray-400">No devices found for the selected user.</td></tr>`
        : devs.map((d: Device, idx: number) => `
          <tr>
            <td class="px-6 py-4 whitespace-nowrap"><div class="text-sm font-medium text-gray-900 dark:text-white">${d.name}</div></td>
            <td class="px-6 py-4 whitespace-nowrap"><div class="text-sm text-gray-500 dark:text-gray-400">${d.type}</div></td>
            <td class="px-6 py-4 whitespace-nowrap"><div class="text-sm text-gray-500 dark:text-gray-400">${d.location || '-'}</div></td>
            <td class="px-6 py-4 whitespace-nowrap">
              <span class="px-2 inline-flex text-xs leading-5 font-semibold rounded-full ${d.status === 'Active' ? 'bg-green-100 text-green-800 dark:bg-green-900 dark:text-green-200' : 'bg-red-100 text-red-800 dark:bg-red-900 dark:text-red-200'}">
                ${d.status}
              </span>
            </td>
            <td class="px-6 py-4 whitespace-nowrap text-right">
              <div class="flex items-center gap-2 justify-end">
                <button data-action="edit" data-index="${idx}" class="px-3 py-1.5 bg-gray-100 dark:bg-gray-700 text-gray-900 dark:text-white rounded border border-gray-300 dark:border-gray-600">Edit</button>
                <button data-action="delete" data-index="${idx}" class="px-3 py-1.5 bg-red-600 hover:bg-red-700 text-white rounded">Delete</button>
              </div>
            </td>
          </tr>
        `).join('');
    }

    // Event bindings
    cancelBtn?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });

    // Save edits
    form?.addEventListener('submit', (e) => {
      e.preventDefault();
      if (!nameInput || !typeInput || !locInput || !statusInput || !editIndexInput) return;
      const idx = editIndexInput.value ? Number(editIndexInput.value) : null;
      if (idx === null) return;
      const devs = loadDevices();
      devs[idx] = {
        name: nameInput.value.trim(),
        type: typeInput.value,
        location: locInput.value.trim(),
        status: statusInput.value as Device['status'],
      };
      saveDevices(devs);
      closeModal();
      render();
    });

    // Row actions: edit/delete
    if (tbody) {
      tbody.addEventListener('click', (e) => {
        const target = e.target as HTMLElement;
        const btn = target.closest('button');
        if (!btn) return;
        const action = btn.getAttribute('data-action');
        const idxStr = btn.getAttribute('data-index');
        if (!action || idxStr === null) return;
        const index = Number(idxStr);
        const devs = loadDevices();

        if (action === 'edit') {
          openModal(index, devs[index]);
        } else if (action === 'delete') {
          if (confirm('Delete this device?')) {
            devs.splice(index, 1);
            saveDevices(devs);
            render();
          }
        }
      });
    }

    // Initial render; seed storage if empty
    if (!localStorage.getItem(STORAGE_KEY)) {
      saveDevices(defaultDevices);
    }
    render();
  });
</script>
