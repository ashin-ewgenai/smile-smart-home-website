---
import Layout from '../../layouts/Layout.astro';
import DashboardApp from '../../components/dashboard/User/DashboardApp';
---

<Layout title="User Dashboard - Smile Smart Homes">
  <DashboardApp client:only="react" />
</Layout>

<script>
  // Check if user is logged in
  document.addEventListener('DOMContentLoaded', () => {
    // This is a simple check - in a real app, you would use Firebase Auth or similar
    const userEmail = localStorage.getItem('userEmail');
    
    if (!userEmail) {
      // Redirect to login if not logged in
      window.location.href = '/login';
    }
  });
</script>
