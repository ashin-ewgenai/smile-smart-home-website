---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import { StaggerContainer, StaggerItem } from '../components/ui/MotionIsland';
import LiquidIntelligence from '../components/about/LiquidIntelligence';
import InnovationDNA from '../components/about/InnovationDNA';
import GlassCard from '../components/ui/GlassCard';
import MagneticButton from '../components/ui/MagneticButton';
import SmartModeToggle from '../components/about/SmartModeToggle';
import { motion, useScroll, useTransform } from 'framer-motion';
---

<Layout title="About Us - Smile Smart Homes">
  <Navigation />
  <SmartModeToggle client:load />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="relative min-h-[96vh] md:min-h-[92vh] section-padding overflow-hidden flex items-center">
      <!-- Premium Liquid Background -->
      <LiquidIntelligence client:load />
      
      <!-- Parallax Floating Assets -->
      <div class="absolute inset-0 pointer-events-none overflow-hidden">
        <motion.div 
          client:load
          initial={{ opacity: 0, y: 100 }}
          animate={{ opacity: 0.1, y: 0 }}
          transition={{ duration: 1.5, delay: 0.5 }}
          style={{ 
            position: 'absolute',
            top: '20%',
            right: '15%',
            width: '300px',
            height: '300px',
            background: 'radial-gradient(circle, #14b8a6 0%, transparent 70%)',
            filter: 'blur(80px)'
          }}
        />
        <motion.div 
          client:load
          initial={{ opacity: 0, x: -100 }}
          animate={{ opacity: 0.05, x: 0 }}
          transition={{ duration: 1.5, delay: 0.8 }}
          style={{ 
            position: 'absolute',
            bottom: '10%',
            left: '5%',
            width: '400px',
            height: '400px',
            background: 'radial-gradient(circle, #3b82f6 0%, transparent 70%)',
            filter: 'blur(100px)'
          }}
        />
      </div>

      <div class="container relative z-10 py-0">
        <div class="max-w-4xl mx-auto text-center reveal-on-scroll">
          <!-- Company Logo/Icon with Hover Rotation -->
          <motion.div 
            client:load
            whileHover={{ rotateY: 180 }}
            transition={{ duration: 0.6 }}
            class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-teal/20 to-blue-500/20 dark:from-teal/30 dark:to-blue-500/30 rounded-3xl mb-8 mx-auto backdrop-blur-sm border border-white/20 shadow-2xl cursor-pointer"
          >
            <svg class="w-12 h-12 text-teal" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12,2C13.1,2 14,2.9 14,4C14,5.1 13.1,6 12,6C10.9,6 10,5.1 10,4C10,2.9 10.9,2 12,2M21,9V7L12,2L3,7V9C3,14.55 6.84,19.74 12,21C17.16,19.74 21,14.55 21,9M12,4.5L18.5,7.5V9C18.5,13.39 15.86,17.53 12,18.5C8.14,17.53 5.5,13.39 5.5,9V7.5L12,4.5Z" />
            </svg>
          </motion.div>
          
          <h1 class="text-display font-bold text-charcoal dark:text-white mb-6 leading-tight">
            Architecting <span class="bg-gradient-to-r from-teal to-blue-600 bg-clip-text text-transparent">Smarter Living</span>
          </h1>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
            We're not just installing devices; we're crafting intelligent environments. Driven by GenAI research and a passion for excellence, Smile Smart Homes brings the future to your doorstep.
          </p>
          
          <!-- Trust Indicators with Glassmorphism -->
          <div class="flex flex-wrap justify-center gap-6 mt-12 md:mt-16">
            <MagneticButton client:load>
              <GlassCard client:load className="px-6 py-3 flex items-center space-x-3 border-white/20 cursor-pointer hover:bg-white/10 transition-colors">
                <div class="w-8 h-8 bg-green-500/20 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-sm font-semibold text-charcoal dark:text-white">500+ Homes</span>
              </GlassCard>
            </MagneticButton>
            <MagneticButton client:load>
              <GlassCard client:load className="px-6 py-3 flex items-center space-x-3 border-white/20 cursor-pointer hover:bg-white/10 transition-colors">
                <div class="w-8 h-8 bg-yellow-500/20 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-yellow-600 dark:text-yellow-400" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                  </svg>
                </div>
                <span class="text-sm font-semibold text-charcoal dark:text-white">98% Satisfaction</span>
              </GlassCard>
            </MagneticButton>
            <MagneticButton client:load>
              <GlassCard client:load className="px-6 py-3 flex items-center space-x-3 border-white/20 cursor-pointer hover:bg-white/10 transition-colors">
                <div class="w-8 h-8 bg-blue-500/20 rounded-full flex items-center justify-center">
                  <svg class="w-4 h-4 text-blue-600 dark:text-blue-400" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <span class="text-sm font-semibold text-charcoal dark:text-white">5+ Years</span>
              </GlassCard>
            </MagneticButton>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Our Story -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="reveal-on-scroll">
            <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-6">
              Our Mission
            </h2>
            <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-6">
              At Smile Smart Homes, we believe that technology should enhance your life, not complicate it. We specialize in professional installation and setup of smart home devices, making advanced home automation accessible and easy to use.
            </p>
            <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-6">
              Our certified technicians handle everything from initial consultation to final setup, ensuring your smart home system works perfectly from day one.
            </p>
            <div class="flex items-center space-x-4">
              <div class="w-16 h-16 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center">
                <svg class="w-8 h-8 text-teal" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
                </svg>
              </div>
              <div>
                <h3 class="text-lg font-semibold text-charcoal dark:text-white">Professional Excellence</h3>
                <p class="text-gray-600 dark:text-gray-300">Certified technicians with proven expertise</p>
              </div>
            </div>
          </div>
          
          <div class="reveal-on-scroll">
            <img 
              src="https://images.pexels.com/photos/1571460/pexels-photo-1571460.jpeg?auto=compress&cs=tinysrgb&w=800" 
              alt="Smart home technology setup"
              class="rounded-lg shadow-lg w-full h-96 object-cover"
              loading="lazy"
            />
          </div>
        </div>
      </div>
    </section>
    
    <!-- What We Do -->
    <section class="section-padding bg-soft-gray dark:bg-gray-800">
      <div class="container">
        <div class="text-center mb-16 reveal-on-scroll">
          <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-4">
            What We Do
          </h2>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            We handle professional installation and setup - not device manufacturing. We work with leading brands to bring you the best smart home solutions.
          </p>
        </div>
        
        <StaggerContainer client:load className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <StaggerItem>
            <div class="group relative overflow-hidden bg-white dark:bg-gray-900 rounded-3xl p-8 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 border border-transparent hover:border-teal/20">
              <div class="absolute inset-0 bg-gradient-to-br from-teal/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div class="relative z-10">
                <div class="w-16 h-16 bg-teal/10 dark:bg-teal/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500">
                  <svg class="w-8 h-8 text-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-charcoal dark:text-white mb-4">Expert Installation</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                  Our certified technicians ensure every device is mounted, powered, and configured with millimetric precision.
                </p>
                <!-- X-Ray Reveal Element -->
                <div class="mt-6 h-1 w-0 group-hover:w-full bg-gradient-to-r from-teal to-blue-500 transition-all duration-700"></div>
              </div>
            </div>
          </StaggerItem>
          
          <StaggerItem>
            <div class="group relative overflow-hidden bg-white dark:bg-gray-900 rounded-3xl p-8 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 border border-transparent hover:border-blue-500/20">
              <div class="absolute inset-0 bg-gradient-to-br from-blue-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div class="relative z-10">
                <div class="w-16 h-16 bg-blue-500/10 dark:bg-blue-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500">
                  <svg class="w-8 h-8 text-blue-500" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3z"></path>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-charcoal dark:text-white mb-4">Unified Ecosystems</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                  We weave fragmented devices into a single, cohesive intelligence that speaks your language.
                </p>
                <div class="mt-6 h-1 w-0 group-hover:w-full bg-gradient-to-r from-blue-500 to-purple-500 transition-all duration-700"></div>
              </div>
            </div>
          </StaggerItem>
          
          <StaggerItem>
            <div class="group relative overflow-hidden bg-white dark:bg-gray-900 rounded-3xl p-8 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 border border-transparent hover:border-purple-500/20">
              <div class="absolute inset-0 bg-gradient-to-br from-purple-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
              <div class="relative z-10">
                <div class="w-16 h-16 bg-purple-500/10 dark:bg-purple-500/20 rounded-2xl flex items-center justify-center mb-6 group-hover:scale-110 transition-transform duration-500">
                  <svg class="w-8 h-8 text-purple-500" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <h3 class="text-2xl font-bold text-charcoal dark:text-white mb-4">Future Support</h3>
                <p class="text-gray-600 dark:text-gray-300 leading-relaxed">
                  Continuous updates and proactive maintenance to keep your home ahead of the technological curve.
                </p>
                <div class="mt-6 h-1 w-0 group-hover:w-full bg-gradient-to-r from-purple-500 to-pink-500 transition-all duration-700"></div>
              </div>
            </div>
          </StaggerItem>
        </StaggerContainer>
      </div>
    </section>
    
    <!-- Innovation DNA Section (AI Synergy) -->
    <InnovationDNA client:load />

    <!-- Company Background -->
    <section class="section-padding bg-white dark:bg-gray-900 overflow-hidden">
      <div class="container">
        <div class="max-w-4xl mx-auto">
          <GlassCard client:load className="p-8 md:p-12 text-center reveal-on-scroll relative">
            <div class="absolute top-0 right-0 w-32 h-32 bg-teal/10 rounded-full blur-3xl -mr-16 -mt-16"></div>
            <div class="absolute bottom-0 left-0 w-32 h-32 bg-blue-500/10 rounded-full blur-3xl -ml-16 -mb-16"></div>
            
            <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-6 relative z-10">
              Backed by Intelligence
            </h2>
            <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-8 relative z-10">
              Smile Smart Homes is proudly powered by <strong>Expectation Walkers GenAI Research and Services Pvt Ltd</strong>, integrating advanced artificial intelligence and research-driven innovation into every home setup.
            </p>
            
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center relative z-10">
              <div class="group">
                <div class="text-4xl font-bold text-teal mb-2 group-hover:scale-110 transition-transform">500+</div>
                <div class="text-gray-600 dark:text-gray-300 font-medium">Homes Automated</div>
              </div>
              <div class="group">
                <div class="text-4xl font-bold text-teal mb-2 group-hover:scale-110 transition-transform">98%</div>
                <div class="text-gray-600 dark:text-gray-300 font-medium">Customer Satisfaction</div>
              </div>
              <div class="group">
                <div class="text-4xl font-bold text-teal mb-2 group-hover:scale-110 transition-transform">5+</div>
                <div class="text-gray-600 dark:text-gray-300 font-medium">Years Experience</div>
              </div>
            </div>
          </GlassCard>
        </div>
      </div>
    </section>
    
    <!-- Important Note -->
    <section class="section-padding bg-soft-gray dark:bg-gray-800">
      <div class="container">
        <div class="max-w-3xl mx-auto text-center reveal-on-scroll">
          <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800 rounded-lg p-6">
            <div class="flex items-center justify-center mb-4">
              <svg class="w-8 h-8 text-amber-600 dark:text-amber-400" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-amber-800 dark:text-amber-200 mb-2">
              Important Note
            </h3>
            <p class="text-amber-700 dark:text-amber-300">
              We specialize in professional installation and setup services. All smart home devices are manufactured by their respective brands (Google, Amazon, Philips, Ring, etc.). We are authorized installers and service providers, ensuring proper setup and integration of these quality products.
            </p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section class="section-padding bg-teal text-white">
      <div class="container text-center">
        <h2 class="text-heading-lg font-bold mb-4 reveal-on-scroll">
          Ready to Transform Your Home?
        </h2>
        <p class="text-body-lg mb-8 max-w-2xl mx-auto opacity-90 reveal-on-scroll">
          Let our experienced team help you create the perfect smart home setup tailored to your needs and lifestyle.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center reveal-on-scroll">
          <MagneticButton client:load>
            <a href="/contact" class="bg-white text-teal hover:bg-gray-100 px-8 py-3 rounded-lg font-bold transition-all duration-120 block shadow-xl">
              Get Free Consultation
            </a>
          </MagneticButton>
          <MagneticButton client:load>
            <a href="/services" class="border-2 border-white text-white hover:bg-white hover:text-teal px-8 py-3 rounded-lg font-bold transition-all duration-120 block">
              View Services
            </a>
          </MagneticButton>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>