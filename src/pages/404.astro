---
import Layout from "../layouts/Layout.astro";
---

<Layout title="404 • Page not found" description="The page you’re looking for doesn’t exist or was moved.">
  <section class="min-h-[70vh] flex items-center justify-center px-6 py-24 bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <div class="max-w-2xl w-full text-center">
      <p class="text-sm font-semibold tracking-widest text-indigo-600 dark:text-indigo-400">Error 404</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Page not found</h1>
      <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
        The page you’re looking for doesn’t exist or was moved.
      </p>

      <div class="mt-8 flex items-center justify-center gap-3">
        <a href="/" class="btn-magnetic inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-white shadow hover:bg-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-400">
          Go to Home
        </a>
        <a href="/" onclick="history.back(); return false;" class="inline-flex items-center rounded-md border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-900">
          Go Back
        </a>
      </div>

      <div class="mt-10 text-xs text-gray-500 dark:text-gray-400">
        If you believe this is a mistake, please try again later or contact site support.
      </div>
    </div>
  </section>
</Layout>
