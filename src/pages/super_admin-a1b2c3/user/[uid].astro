---
import Layout from '../../../layouts/Layout.astro';
import SuperAdminLayout from '../../../components/superadmin/SuperAdminLayout';
import UserEdit from '../../../components/superadmin/UserEdit';

// Type assert to satisfy TS: Astro.params values may be undefined at type-level
const { uid } = Astro.params as { uid: string };
export const prerender = false;
---

<Layout title="Edit User - Super Admin">
  <SuperAdminLayout client:load>
    <UserEdit uid={uid} client:load />
  </SuperAdminLayout>
</Layout>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    try {
      const role = localStorage.getItem('userRole');
      if (role !== 'Super Admin') {
        window.location.href = '/admin_login';
      }
    } catch {}
  });
</script>
