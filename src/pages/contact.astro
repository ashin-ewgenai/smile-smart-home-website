---
import Layout from "../layouts/Layout.astro";
import Navigation from "./Navigation.astro";
import ContactForm from "../components/contact/ContactForm";

import Footer from "./Footer.astro";
---

<Layout title="Contact Us - Smile Smart Homes">
  <Navigation />

  <main class="pt-16">
    <!-- Hero Section -->
    <!-- Hero Section -->
    <section
      class="relative min-h-[92vh] md:min-h-[88vh] section-padding bg-gradient-to-br from-soft-gray via-white to-gray-100 dark:from-gray-900 dark:via-charcoal dark:to-gray-800 overflow-hidden flex items-center"
    >
      <!-- Dynamic Background Elements (Aligned with Services) -->
      <div class="absolute inset-0 opacity-8 dark:opacity-4">
        <div class="absolute top-20 right-20 w-28 h-28 bg-gradient-to-r from-green-400 to-teal rounded-2xl rotate-12 animate-pulse"></div>
        <div class="absolute bottom-24 left-16 w-20 h-20 border-2 border-blue-400/30 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/3 left-1/4 w-12 h-12 bg-purple-400/40 rounded-lg rotate-45 animate-pulse" style="animation-delay: 1.8s;"></div>
        <div class="absolute bottom-1/3 right-1/3 w-8 h-8 bg-yellow-400 rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>

      <div class="container relative z-10 py-0">
        <div class="text-center max-w-4xl mx-auto mt-8">
          <!-- Contact Icon -->
          <div
            class="inline-flex items-center justify-center w-20 h-20 bg-teal/10 dark:bg-teal/20 rounded-2xl mb-8 mx-auto reveal-on-scroll"
          >
            <svg
              class="w-10 h-10 text-teal"
              fill="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                d="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0  0,1 20,21A17,17 0 0,1 3,4A1,1 0  0,1 4,3H7.5A1,1 0  0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z"
              ></path>
            </svg>
          </div>

          <h1 class="text-4xl md:text-display font-bold text-charcoal dark:text-white mb-6 leading-tight reveal-on-scroll">
            <span
              class="bg-gradient-to-r from-teal to-blue-600 bg-clip-text text-transparent"
              >Live Consultation</span
            >
          </h1>
          <p
            class="text-body-lg text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto reveal-on-scroll"
          >
            Ready to transform your home with smart technology? Contact our
            experts today for a personalized consultation and quote.
          </p>

          <!-- Service Highlights -->
          <div
            class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8 mt-20 md:mt-28 pt-16 md:pt-20 max-w-3xl mx-auto reveal-on-scroll"
            data-contact="highlights"
          >
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-teal/30 transition-all duration-300 hover:-translate-y-1 group"
              data-hide-when="authed"
            >
              <div class="text-3xl font-bold text-teal mb-2 group-hover:scale-110 transition-transform">Free</div>
              <div class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Consultation
              </div>
            </div>
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-blue-600/30 transition-all duration-300 hover:-translate-y-1 group"
            >
              <div class="text-3xl font-bold text-blue-600 mb-2 group-hover:scale-110 transition-transform">24hr</div>
              <div class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">
                Response
              </div>
            </div>
            <div
              class="bg-white dark:bg-gray-800 rounded-2xl p-6 shadow-sm border border-gray-200 dark:border-gray-700 hover:border-purple-600/30 transition-all duration-300 hover:-translate-y-1 group"
            >
              <div class="text-3xl font-bold text-purple-600 mb-2 group-hover:scale-110 transition-transform">Expert</div>
              <div class="text-sm font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">Advice</div>
            </div>
          </div>

          <a
            href="#contact-form"
            data-hide-when="authed"
            class="inline-flex items-center bg-teal hover:bg-teal/90 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-300 transform hover:scale-[1.02] hover:shadow-lg cursor-pointer group mt-6 md:mt-8 btn-magnetic reveal-on-scroll"
          >
            <svg
              class="w-5 h-5 mr-3 group-hover:rotate-12 transition-transform duration-300"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              stroke-width="2"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
            </svg>
            Start Your Free Consultation
          </a>

          <!-- Scroll Indicator -->
          <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center animate-bounce opacity-40 reveal-on-scroll">
            <span class="text-xs text-gray-400 dark:text-gray-500 font-medium mb-2 uppercase tracking-widest">Scroll</span>
            <svg class="w-5 h-5 text-gray-400 dark:text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7-7-7" />
            </svg>
          </div>
        </div>
      </div>
    </section>

    <!-- Contact Information & Form (Public Only) -->
    <section
      class="section-padding bg-white dark:bg-gray-900"
      data-contact="public"
    >
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Contact Information -->
          <!-- Contact Information: Bento Grid -->
          <div class="reveal-on-scroll">
            <h2
              class="text-heading-lg font-bold text-charcoal dark:text-white mb-8"
            >
              Get in <span class="font-serif italic text-teal">Touch</span>
            </h2>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <!-- Phone Card -->
              <a href="tel:+15551234567" 
                 class="group p-6 rounded-2xl bg-teal/5 dark:bg-teal/10 border border-teal/10 hover:border-teal/30 hover:bg-teal/10 transition-all duration-300">
                <div class="w-12 h-12 bg-teal text-white rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-charcoal dark:text-white mb-1">Phone</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Immediate assistance</p>
                <span class="text-teal font-semibold">+1 (555) 123-4567</span>
              </a>

              <!-- Email Card -->
              <a href="mailto:hello@smilesmarthomes.com" 
                 class="group p-6 rounded-2xl bg-blue-500/5 dark:bg-blue-500/10 border border-blue-500/10 hover:border-blue-500/30 hover:bg-blue-500/10 transition-all duration-300">
                <div class="w-12 h-12 bg-blue-600 text-white rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                  </svg>
                </div>
                <h3 class="text-lg font-bold text-charcoal dark:text-white mb-1">Email</h3>
                <p class="text-sm text-gray-600 dark:text-gray-400 mb-2">Detailed messages</p>
                <span class="text-blue-600 font-semibold">hello@smilesmarthomes.com</span>
              </a>

              <!-- WhatsApp Card (Wide) -->
              <a href="https://wa.me/15551234567" 
                 class="group p-6 rounded-2xl bg-green-500/5 dark:bg-green-500/10 border border-green-500/10 hover:border-green-500/30 hover:bg-green-500/10 transition-all duration-300 sm:col-span-2">
                <div class="flex items-center space-x-6">
                  <div class="w-14 h-14 bg-green-500 text-white rounded-2xl flex items-center justify-center flex-shrink-0 group-hover:rotate-12 transition-transform">
                    <svg class="w-8 h-8" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488" />
                    </svg>
                  </div>
                  <div>
                    <h3 class="text-xl font-bold text-charcoal dark:text-white">WhatsApp</h3>
                    <p class="text-gray-600 dark:text-gray-400">Chat directly with an expert</p>
                  </div>
                  <div class="ml-auto">
                    <span class="inline-flex items-center px-4 py-2 rounded-full bg-green-500 text-white text-sm font-bold animate-pulse">Online</span>
                  </div>
                </div>
              </a>

              <!-- Hours Card -->
              <div class="p-6 rounded-2xl bg-gray-50 dark:bg-gray-800/40 border border-gray-200 dark:border-gray-700 sm:col-span-2">
                <div class="flex items-center space-x-4 mb-4">
                  <div class="w-10 h-10 bg-gray-200 dark:bg-gray-700 rounded-lg flex items-center justify-center">
                    <svg class="w-6 h-6 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                  </div>
                  <h3 class="text-lg font-bold text-charcoal dark:text-white">Business Hours</h3>
                </div>
                <div class="grid grid-cols-2 gap-4 text-sm">
                  <div class="space-y-1">
                    <p class="text-gray-500">Mon - Fri</p>
                    <p class="font-semibold">9:00 AM - 6:00 PM</p>
                  </div>
                  <div class="space-y-1">
                    <p class="text-gray-500">Saturday</p>
                    <p class="font-semibold">10:00 AM - 4:00 PM</p>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Contact Form Container -->
          <div id="contact-form" class="reveal-on-scroll">
            <div
              class="relative bg-white dark:bg-gray-900 rounded-3xl p-8 md:p-12 border border-gray-200 dark:border-gray-700 shadow-[0_20px_50px_rgba(0,150,136,0.05)] dark:shadow-[0_20px_50px_rgba(0,0,0,0.3)] overflow-hidden"
            >
              <!-- Decorative Background Elements -->
              <div
                class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-teal/10 to-blue-500/10 rounded-full blur-2xl -translate-y-16 translate-x-16"
              >
              </div>
              <div
                class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-purple-500/10 to-pink-500/10 rounded-full blur-xl translate-y-12 -translate-x-12"
              >
              </div>
              <div
                class="absolute top-1/2 left-1/2 w-40 h-40 bg-gradient-to-r from-yellow-400/5 to-orange-500/5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"
              >
              </div>

              <!-- Content -->
              <div class="relative z-10">
                <div class="flex items-center mb-8">
                  <div
                    class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-br from-teal/20 to-blue-500/20 rounded-xl mr-4"
                  >
                    <svg
                      class="w-6 h-6 text-teal"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
                        d="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z"
                      ></path>
                    </svg>
                  </div>
                  <h2
                    class="text-2xl md:text-3xl font-bold text-charcoal dark:text-white"
                  >
                    <span
                      class="bg-gradient-to-r from-teal to-blue-600 bg-clip-text text-transparent"
                      >Send us</span
                    > a Message
                  </h2>
                </div>
                <ContactForm client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Logged-in Contact (Members Only) -->
    <section
      class="section-padding bg-white dark:bg-gray-900 hidden"
      data-contact="user"
    >
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Member Help Overview -->
          <div>
            <h2
              class="text-heading-lg font-bold text-charcoal dark:text-white mb-4"
            >
              Need help, <span class="font-serif italic text-teal" data-contact="user-name"
                >there</span
              >?
            </h2>
            <p class="text-gray-600 dark:text-gray-300 mb-8">
              As a valued member, you have access to priority support channels. How can we assist you today?
            </p>

            <div class="grid grid-cols-1 gap-4">
              <a href="/dashboard/user/support-tickets" data-astro-reload 
                 class="group p-5 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/40 hover:border-teal/30 transition-all duration-300 flex items-center">
                <div class="w-12 h-12 bg-teal/10 text-teal rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 5v2m0 4v2m0 4v2M5 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-charcoal dark:text-white">Raise a Support Ticket</h3>
                  <p class="text-xs text-gray-500">Track issues and get status updates</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <a href="/dashboard/user/quote-portal" 
                 class="group p-5 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/40 hover:border-blue-500/30 transition-all duration-300 flex items-center">
                <div class="w-12 h-12 bg-blue-500/10 text-blue-600 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 7h6m0 10v-3m-3 3h.01M9 17h.01M9 14h.01M12 14h.01M15 11h.01M12 11h.01M9 11h.01M7 21h10a2 2 0 002-2V5a2 2 0 00-2-2H7a2 2 0 00-2 2v14a2 2 0 002 2z" />
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-charcoal dark:text-white">Request a New Quote</h3>
                  <p class="text-xs text-gray-500">Start a new project with saved details</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>

              <a href="/dashboard/user/support-chat" data-astro-reload 
                 class="group p-5 rounded-2xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800/40 hover:border-purple-600/30 transition-all duration-300 flex items-center">
                <div class="w-12 h-12 bg-purple-500/10 text-purple-600 rounded-xl flex items-center justify-center mr-4 group-hover:scale-110 transition-transform">
                  <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                  </svg>
                </div>
                <div class="flex-1">
                  <h3 class="font-bold text-charcoal dark:text-white">Priority Support Chat</h3>
                  <p class="text-xs text-gray-500">Real-time assistance with our experts</p>
                </div>
                <svg class="w-5 h-5 text-gray-400 group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            </div>
          </div>

          <!-- Quick Contacts -->
          <div class="reveal-on-scroll lg:self-end">
            <div
              class="rounded-2xl border border-gray-200 dark:border-gray-700 p-4 bg-white/70 dark:bg-gray-900/70"
            >
              <h3
                class="text-xl font-semibold text-charcoal dark:text-white mb-3"
              >
                Account & Priority Contacts
              </h3>
              <div class="space-y-4">
                <!-- Phone -->
                <div class="flex items-start space-x-4">
                  <div
                    class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0"
                  >
                    <svg
                      class="w-6 h-6 text-teal"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h4
                      class="text-lg font-semibold text-charcoal dark:text-white mb-1"
                    >
                      Phone
                    </h4>
                    <a
                      href="tel:+15551234567"
                      class="text-teal hover:text-teal/80 font-medium"
                      >+1 (555) 123-4567</a
                    >
                  </div>
                </div>

                <!-- Email -->
                <div class="flex items-start space-x-4">
                  <div
                    class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0"
                  >
                    <svg
                      class="w-6 h-6 text-teal"
                      fill="currentColor"
                      viewBox="0 0 20 20"
                    >
                      <path
                        d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"
                      ></path>
                      <path
                        d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"
                      ></path>
                    </svg>
                  </div>
                  <div>
                    <h4
                      class="text-lg font-semibold text-charcoal dark:text-white mb-1"
                    >
                      Email
                    </h4>
                    <a
                      href="mailto:support@smilesmarthomes.com"
                      class="text-teal hover:text-teal/80 font-medium"
                      >support@smilesmarthomes.com</a
                    >
                  </div>
                </div>

                <!-- WhatsApp -->
                <div class="flex items-start space-x-4">
                  <div
                    class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center flex-shrink-0"
                  >
                    <svg
                      class="w-6 h-6 text-green-600 dark:text-green-400"
                      fill="currentColor"
                      viewBox="0 0 24 24"
                    >
                      <path
