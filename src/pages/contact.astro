---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import ContactForm from '../components/contact/ContactForm';

import Footer from './Footer.astro';
---

<Layout title="Contact Us - Smile Smart Homes">
  <Navigation />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="relative min-h-[92vh] md:min-h-[88vh] section-padding bg-gradient-to-br from-soft-gray via-white to-gray-100 dark:from-gray-900 dark:via-charcoal dark:to-gray-800 overflow-hidden flex items-center">
      <!-- Dynamic Background Elements -->
      <div class="absolute inset-0 opacity-8 dark:opacity-4">
        <div class="absolute top-20 right-20 w-28 h-28 bg-gradient-to-r from-green-400 to-teal rounded-2xl rotate-12 animate-pulse"></div>
        <div class="absolute bottom-24 left-16 w-20 h-20 border-2 border-blue-400/30 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/3 left-1/4 w-12 h-12 bg-purple-400/40 rounded-lg rotate-45 animate-pulse" style="animation-delay: 1.8s;"></div>
        <div class="absolute bottom-1/3 right-1/3 w-8 h-8 bg-yellow-400 rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>
      
      <div class="container relative z-10 py-0">
        <div class="text-center max-w-4xl mx-auto reveal-on-scroll">
          <!-- Contact Icon -->
          <div class="inline-flex items-center justify-center w-24 h-24 bg-gradient-to-br from-teal/20 to-blue-500/20 dark:from-teal/30 dark:to-blue-500/30 rounded-3xl mb-8 mx-auto backdrop-blur-sm border border-white/20">
            <svg class="w-12 h-12 text-teal dark:text-teal" fill="currentColor" viewBox="0 0 24 24">
              <path d="M6.62,10.79C8.06,13.62 10.38,15.94 13.21,17.38L15.41,15.18C15.69,14.9 16.08,14.82 16.43,14.93C17.55,15.3 18.75,15.5 20,15.5A1,1 0 0,1 21,16.5V20A1,1 0 0,1 20,21A17,17 0 0,1 3,4A1,1 0 0,1 4,3H7.5A1,1 0 0,1 8.5,4C8.5,5.25 8.7,6.45 9.07,7.57C9.18,7.92 9.1,8.31 8.82,8.59L6.62,10.79Z" />
            </svg>
          </div>
          
          <h1 class="text-display font-bold text-charcoal dark:text-white mb-6">
            <span class="bg-gradient-to-r from-teal to-blue-600 bg-clip-text text-transparent">Live Consultation</span>
          </h1>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
            Ready to transform your home with smart technology? Contact our experts today for a personalized consultation and quote.
          </p>
          
          <!-- Service Highlights -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8 max-w-2xl mx-auto" data-contact="highlights">
            <div class="bg-white/40 dark:bg-gray-800/40 backdrop-blur-sm rounded-xl p-4 border border-white/20" data-hide-when="authed">
              <div class="text-2xl font-bold text-teal mb-1">Free</div>
              <div class="text-xs text-gray-600 dark:text-gray-400">Consultation</div>
            </div>
            <div class="bg-white/40 dark:bg-gray-800/40 backdrop-blur-sm rounded-xl p-4 border border-white/20">
              <div class="text-2xl font-bold text-blue-600 mb-1">24hr</div>
              <div class="text-xs text-gray-600 dark:text-gray-400">Response</div>
            </div>
            <div class="bg-white/40 dark:bg-gray-800/40 backdrop-blur-sm rounded-xl p-4 border border-white/20">
              <div class="text-2xl font-bold text-purple-600 mb-1">Expert</div>
              <div class="text-xs text-gray-600 dark:text-gray-400">Advice</div>
            </div>
          </div>
          
          <!-- CTA Button -->
          <a href="#contact-form" data-hide-when="authed" class="inline-flex items-center bg-gradient-to-r from-teal to-blue-600 hover:from-teal/90 hover:to-blue-700 text-white px-8 py-4 rounded-full font-medium transition-all duration-200 transform hover:scale-105 cursor-pointer group">
            <svg class="w-5 h-5 mr-2 group-hover:rotate-12 transition-transform duration-200" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
            </svg>
            Start Your Free Consultation
          </a>
        </div>
      </div>
    </section>
    
    <!-- Contact Information & Form (Public Only) -->
    <section class="section-padding bg-white dark:bg-gray-900" data-contact="public">
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
          <!-- Contact Information -->
          <div class="reveal-on-scroll">
            <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-8">
              Get in Touch
            </h2>
            
            <div class="space-y-8">
              <!-- Phone -->
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Phone</h3>
                  <p class="text-gray-600 dark:text-gray-300 mb-2">Call us for immediate assistance</p>
                  <a href="tel:+15551234567" class="text-teal hover:text-teal/80 font-medium">
                    +1 (555) 123-4567
                  </a>
                </div>
              </div>
              
              <!-- Email -->
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                    <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Email</h3>
                  <p class="text-gray-600 dark:text-gray-300 mb-2">Send us a detailed message</p>
                  <a href="mailto:hello@smilesmarthomes.com" class="text-teal hover:text-teal/80 font-medium">
                    hello@smilesmarthomes.com
                  </a>
                </div>
              </div>
              
              <!-- WhatsApp -->
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 24 24">
                    <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">WhatsApp</h3>
                  <p class="text-gray-600 dark:text-gray-300 mb-2">Quick consultation and quotes</p>
                  <a 
                    href="https://wa.me/15551234567?text=I%20want%20a%20smart%20home%20consultation"
                    class="inline-flex items-center text-green-600 dark:text-green-400 hover:text-green-700 dark:hover:text-green-300 font-medium"
                  >
                    <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                    </svg>
                    Chat with us on WhatsApp
                  </a>
                </div>
              </div>
              
              <!-- Hours -->
              <div class="flex items-start space-x-4">
                <div class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0">
                  <svg class="w-6 h-6 text-teal" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                  </svg>
                </div>
                <div>
                  <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Business Hours</h3>
                  <div class="text-gray-600 dark:text-gray-300 space-y-1">
                    <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
                    <p>Saturday: 10:00 AM - 4:00 PM</p>
                    <p>Sunday: Closed</p>
                  </div>
                </div>
              </div>
            </div>
          </div>
          
          <!-- Contact Form -->
          <div id="contact-form" class="reveal-on-scroll">
            <div class="relative bg-white/80 dark:bg-gray-900/80 backdrop-blur-md rounded-2xl p-8 md:p-10 border border-gray-200/60 dark:border-gray-700/60 shadow-xl overflow-hidden">
              <!-- Decorative Background Elements -->
              <div class="absolute top-0 right-0 w-32 h-32 bg-gradient-to-br from-teal/10 to-blue-500/10 rounded-full blur-2xl -translate-y-16 translate-x-16"></div>
              <div class="absolute bottom-0 left-0 w-24 h-24 bg-gradient-to-tr from-purple-500/10 to-pink-500/10 rounded-full blur-xl translate-y-12 -translate-x-12"></div>
              <div class="absolute top-1/2 left-1/2 w-40 h-40 bg-gradient-to-r from-yellow-400/5 to-orange-500/5 rounded-full blur-3xl -translate-x-1/2 -translate-y-1/2"></div>
              
              <!-- Content -->
              <div class="relative z-10">
                <div class="flex items-center mb-8">
                  <div class="inline-flex items-center justify-center w-12 h-12 bg-gradient-to-br from-teal/20 to-blue-500/20 rounded-xl mr-4">
                    <svg class="w-6 h-6 text-teal" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M20,8L12,13L4,8V6L12,11L20,6M20,4H4C2.89,4 2,4.89 2,6V18A2,2 0 0,0 4,20H20A2,2 0 0,0 22,18V6C22,4.89 21.1,4 20,4Z" />
                    </svg>
                  </div>
                  <h2 class="text-2xl md:text-3xl font-bold text-charcoal dark:text-white">
                    <span class="bg-gradient-to-r from-teal to-blue-600 bg-clip-text text-transparent">Send us</span> a Message
                  </h2>
                </div>
                <ContactForm client:load />
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Logged-in Contact (Members Only) -->
    <section class="section-padding bg-white dark:bg-gray-900 hidden" data-contact="user">
      <div class="container">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
          <!-- Member Help Overview -->
          <div>
            <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-4">Need help, <span class="text-teal" data-contact="user-name">there</span>?</h2>
            <p class="text-gray-600 dark:text-gray-300 mb-6">As a logged-in customer, you can reach our team faster using the options below.</p>

            <ul class="space-y-4">
              <li class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/40">
                <h3 class="font-semibold text-charcoal dark:text-white">Raise a Support Ticket</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300">Track issues and get status updates from your dashboard.</p>
                <a href="/dashboard/user/support-tickets" class="inline-block mt-2 px-4 py-2 rounded-lg bg-teal text-white hover:bg-teal/90">Go to Tickets</a>
              </li>
              <li class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/40">
                <h3 class="font-semibold text-charcoal dark:text-white">Request a New Quote</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300">Start a quote with your saved details for faster turnaround.</p>
                <a href="/dashboard/user/quote-portal" class="inline-block mt-2 px-4 py-2 rounded-lg bg-blue-600 text-white hover:bg-blue-700">Open Quote Portal</a>
              </li>
              <li class="p-4 rounded-xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-800/40">
                <h3 class="font-semibold text-charcoal dark:text-white">Support Chat</h3>
                <p class="text-sm text-gray-600 dark:text-gray-300">Start a real-time chat with our support team.</p>
                <button type="button" class="inline-block mt-2 px-4 py-2 rounded-lg bg-purple-600 text-white hover:bg-purple-700" onclick="window.dispatchEvent(new CustomEvent('open-chat'));">Open Chat</button>
              </li>
            </ul>
          </div>

          <!-- Quick Contacts -->
          <div class="reveal-on-scroll lg:self-end">
            <div class="rounded-2xl border border-gray-200 dark:border-gray-700 p-4 bg-white/70 dark:bg-gray-900/70">
              <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-3">Account & Priority Contacts</h3>
              <div class="space-y-4">
                <!-- Phone -->
                <div class="flex items-start space-x-4">
                  <div class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-teal" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-semibold text-charcoal dark:text-white mb-1">Phone</h4>
                    <a href="tel:+15551234567" class="text-teal hover:text-teal/80 font-medium">+1 (555) 123-4567</a>
                  </div>
                </div>

                <!-- Email -->
                <div class="flex items-start space-x-4">
                  <div class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-teal" fill="currentColor" viewBox="0 0 20 20">
                      <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                      <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-semibold text-charcoal dark:text-white mb-1">Email</h4>
                    <a href="mailto:support@smilesmarthomes.com" class="text-teal hover:text-teal/80 font-medium">support@smilesmarthomes.com</a>
                  </div>
                </div>

                <!-- WhatsApp -->
                <div class="flex items-start space-x-4">
                  <div class="w-12 h-12 bg-green-100 dark:bg-green-900 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-green-600 dark:text-green-400" fill="currentColor" viewBox="0 0 24 24">
                      <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893A11.821 11.821 0 0020.885 3.488"/>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-semibold text-charcoal dark:text-white mb-1">WhatsApp</h4>
                    <a 
                      href="https://wa.me/15551234567?text=Hi%2C%20I%27m%20a%20Smile%20Smart%20Homes%20customer%20and%20need%20assistance." 
                      class="inline-flex items-center text-green-600 dark:text-green-400 hover:text-green-700 dark:hover:text-green-300 font-medium"
                    >
                      Message us on WhatsApp
                    </a>
                  </div>
                </div>

                <!-- Business Hours -->
                <div class="flex items-start space-x-4">
                  <div class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center flex-shrink-0">
                    <svg class="w-6 h-6 text-teal" fill="currentColor" viewBox="0 0 20 20">
                      <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
                    </svg>
                  </div>
                  <div>
                    <h4 class="text-lg font-semibold text-charcoal dark:text-white mb-2">Business Hours</h4>
                    <div class="text-gray-600 dark:text-gray-300 space-y-1">
                      <p>Monday - Friday: 9:00 AM - 6:00 PM</p>
                      <p>Saturday: 10:00 AM - 4:00 PM</p>
                      <p>Sunday: Closed</p>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- FAQ Section -->
    <section class="section-padding bg-soft-gray dark:bg-gray-800">
      <div class="container">
        <div class="text-center mb-16 reveal-on-scroll">
          <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-4">
            Frequently Asked Questions
          </h2>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Find answers to common questions about our smart home installation services.
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
            <div class="space-y-6">
              <div class="reveal-on-scroll">
                <h3 class="text-lg font-semibold text-charcoal dark:text-white mb-2">
                  How long does installation take?
                </h3>
                <p class="text-gray-600 dark:text-gray-300">
                  Most installations take 4-8 hours depending on the complexity. Complete home automation can take 1-2 days.
                </p>
              </div>
              
