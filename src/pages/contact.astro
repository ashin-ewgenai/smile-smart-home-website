<script>
  // @ts-nocheck
  // Toggle contact page content for logged-in users.
  (function () {
    const firstFromEmail = (email) => {
      if (!email) return "there";
      const local = email.split("@")[0] || "";
      const first = (local.split(/[._-]+/)[0] || local).trim();
      return first.charAt(0).toUpperCase() + first.slice(1).toLowerCase();
    };
    const update = (isAuthed) => {
      const pub = document.querySelector('[data-contact="public"]');
      const usr = document.querySelector('[data-contact="user"]');
      const highlights = document.querySelector('[data-contact="highlights"]');
      if (!pub || !usr) return;
      if (isAuthed) {
        pub.classList.add("hidden");
        usr.classList.remove("hidden");
        const nameEl = document.querySelector('[data-contact="user-name"]');
        try {
          const email = localStorage.getItem("userEmail");
          if (email && nameEl) nameEl.textContent = firstFromEmail(email);
        } catch {}
        // Hide any elements marked to hide when authed
        document.querySelectorAll('[data-hide-when="authed"]').forEach((el) => {
          el.classList.add("hidden");
          el.setAttribute("aria-hidden", "true");
          el.style.display = "none";
        });
        // Center remaining highlight cards: switch to 2 columns and center items
        if (highlights) {
          highlights.classList.remove("md:grid-cols-3");
          highlights.classList.add("md:grid-cols-2");
          highlights.classList.add("md:justify-items-center");
        }
      } else {
        pub.classList.remove("hidden");
        usr.classList.add("hidden");
        // Show elements again when not authed
        document.querySelectorAll('[data-hide-when="authed"]').forEach((el) => {
          el.classList.remove("hidden");
          el.removeAttribute("aria-hidden");
          el.style.display = "";
        });
        // Restore original 3-column layout and remove centering
        if (highlights) {
          highlights.classList.add("md:grid-cols-3");
          highlights.classList.remove("md:grid-cols-2");
          highlights.classList.remove("md:justify-items-center");
        }
      }
    };

    function run() {
      let authed = false;
      try {
        authed = !!localStorage.getItem("userId");
      } catch {}
      update(authed);
    }
    document.addEventListener("DOMContentLoaded", run);
    document.addEventListener("astro:page-load", run);
  })();
</script>
