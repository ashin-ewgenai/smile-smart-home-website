---
import Layout from "../layouts/Layout.astro";
---

<Layout title="500 • Something went wrong" description="An unexpected error occurred. Please try again.">
  <section class="min-h-[70vh] flex items-center justify-center px-6 py-24 bg-white text-gray-900 dark:bg-gray-950 dark:text-gray-100">
    <div class="max-w-2xl w-full text-center">
      <p class="text-sm font-semibold tracking-widest text-red-600 dark:text-red-400">Error 500</p>
      <h1 class="mt-3 text-4xl font-extrabold tracking-tight sm:text-5xl">Something went wrong</h1>
      <p class="mt-4 text-base text-gray-600 dark:text-gray-400">
        An unexpected error occurred on the server. Please try again in a moment.
      </p>

      <div class="mt-8 flex items-center justify-center gap-3">
        <button onclick="location.reload()" class="btn-magnetic inline-flex items-center rounded-md bg-red-600 px-4 py-2 text-white shadow hover:bg-red-500 focus:outline-none focus:ring-2 focus:ring-red-400">
          Reload Page
        </button>
        <a href="/" class="inline-flex items-center rounded-md border border-gray-300 px-4 py-2 text-gray-700 hover:bg-gray-50 dark:border-gray-700 dark:text-gray-200 dark:hover:bg-gray-900">
          Go to Home
        </a>
      </div>

      <div class="mt-10 text-xs text-gray-500 dark:text-gray-400">
        If the problem persists, please contact site support.
      </div>
    </div>
  </section>
</Layout>
