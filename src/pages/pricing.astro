<script>
  // @ts-nocheck
  // Hide elements marked data-hide-when="authed" for authenticated users
  (function(){
    const toggleAuthedHides = (isAuthed) => {
      const nodes = document.querySelectorAll('[data-hide-when="authed"]');
      nodes.forEach((el) => {
        if (isAuthed) {
          el.classList.add('hidden');
          el.setAttribute('aria-hidden', 'true');
          el.style.display = 'none';
        } else {
          el.classList.remove('hidden');
          el.removeAttribute('aria-hidden');
          el.style.display = '';
        }
      });
    };
    function run(){
      let authed = false;
      try { authed = !!localStorage.getItem('userEmail'); } catch {}
      toggleAuthedHides(authed);
    }
    document.addEventListener('DOMContentLoaded', run);
    document.addEventListener('astro:page-load', run);
  })();
</script>
