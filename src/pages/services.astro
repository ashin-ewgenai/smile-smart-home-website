---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import ServiceCard from '../components/services/ServiceCard.astro';
import Footer from './Footer.astro';
import { StaggerContainer, StaggerItem } from '../components/ui/MotionIsland';
---

<Layout title="Smart Home Services - Smile Smart Homes">
  <Navigation />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="relative min-h-[92vh] md:min-h-[88vh] section-padding bg-gradient-to-br from-soft-gray via-white to-gray-100 dark:from-gray-900 dark:via-charcoal dark:to-gray-800 overflow-hidden flex items-center">
      <!-- Dynamic Background Elements -->
      <div class="absolute inset-0 opacity-8 dark:opacity-4">
        <div class="absolute top-20 right-20 w-28 h-28 bg-gradient-to-r from-green-400 to-teal rounded-2xl rotate-12 animate-pulse"></div>
        <div class="absolute bottom-24 left-16 w-20 h-20 border-2 border-blue-400/30 rounded-full animate-pulse" style="animation-delay: 1s;"></div>
        <div class="absolute top-1/3 left-1/4 w-12 h-12 bg-purple-400/40 rounded-lg rotate-45 animate-pulse" style="animation-delay: 1.8s;"></div>
        <div class="absolute bottom-1/3 right-1/3 w-8 h-8 bg-yellow-400 rounded-full animate-pulse" style="animation-delay: 0.5s;"></div>
      </div>
      
      <div class="container relative z-10 py-0">
        <div class="text-center max-w-4xl mx-auto reveal-on-scroll">
          <!-- Icon Badge -->
          <div class="inline-flex items-center justify-center w-20 h-20 bg-teal/10 dark:bg-teal/20 rounded-2xl mb-6 mx-auto">
            <svg class="w-10 h-10 text-teal" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12,2A2,2 0 0,1 14,4V8A2,2 0 0,1 12,10A2,2 0 0,1 10,8V4A2,2 0 0,1 12,2M21,11H20A8,8 0 0,1 12,19A8,8 0 0,1 4,11H3A1,1 0 0,1 2,10A1,1 0 0,1 3,9H4A8,8 0 0,1 12,1A8,8 0 0,1 20,9H21A1,1 0 0,1 22,10A1,1 0 0,1 21,11M7,11A5,5 0 0,0 12,16A5,5 0 0,0 17,11H16A4,4 0 0,1 12,15A4,4 0 0,1 8,11H7Z" />
            </svg>
          </div>
          
          <h1 class="text-4xl md:text-display font-bold text-charcoal dark:text-white mb-6 leading-tight">
            <span class="block sm:inline">Professional Smart Home</span> 
            <span class="bg-gradient-to-r from-teal to-blue-600 bg-clip-text text-transparent block sm:inline">Services</span>
          </h1>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
            From security systems to entertainment setups, we provide complete smart home solutions tailored to your lifestyle.
          </p>
          
          <!-- Feature Pills -->
          <div class="flex flex-wrap justify-center gap-3 mb-8">
            <span class="inline-flex items-center px-4 py-2 bg-teal/10 dark:bg-teal/20 text-teal rounded-full text-sm font-medium">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              Certified Experts
            </span>
            <span class="inline-flex items-center px-4 py-2 bg-blue-100 dark:bg-blue-900/30 text-blue-600 dark:text-blue-400 rounded-full text-sm font-medium">
              <svg class="w-4 h-4 mr-2" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"></path>
              </svg>
              24/7 Support
            </span>
          </div>
          
          <!-- CTA Buttons -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/contact" data-hide-when="authed" class="bg-teal hover:bg-teal/90 text-white px-8 py-4 rounded-xl font-semibold transition-all duration-200 transform hover:scale-[1.02] hover:shadow-lg inline-flex items-center justify-center group">
              <svg class="w-5 h-5 mr-2 group-hover:rotate-12 transition-transform duration-200" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"></path>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"></path>
              </svg>
              Get Free Quote
            </a>
            <a href="tel:+15551234567" class="border-2 border-teal text-teal hover:bg-teal hover:text-white px-8 py-4 rounded-xl font-semibold transition-all duration-200 inline-flex items-center justify-center group">
              <svg class="w-5 h-5 mr-2 group-hover:scale-110 transition-transform duration-200" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"></path>
              </svg>
              Call Now
            </a>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Services Grid -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container">
        <StaggerContainer client:load className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-2 gap-8 max-w-6xl mx-auto">
          <StaggerItem>
            <ServiceCard 
              icon='<svg fill="currentColor" viewBox="0 0 24 24"><path d="M12,1L3,5V11C3,16.55 6.84,21.74 12,23C17.16,21.74 21,16.55 21,11V5L12,1M12,7C13.4,7 14.8,8.6 14.8,10V11.5C15.4,11.5 16,12.4 16,13V16C16,16.6 15.6,17 15,17H9C8.4,17 8,16.6 8,16V13C8,12.4 8.4,11.5 9,11.5V10C9,8.6 10.6,7 12,7M12,8.2C11.2,8.2 10.2,8.7 10.2,10V11.5H13.8V10C13.8,8.7 12.8,8.2 12,8.2Z" /></svg>'
              title="Security Systems"
              description="Complete home security with smart cameras, door locks, motion sensors, and 24/7 monitoring."
              image="/images/services/security.png"
              features={[
                "HD security cameras with night vision",
                "Smart door locks with keyless entry", 
                "Motion and intrusion detection",
                "Mobile app alerts and control",
                "Professional monitoring available"
              ]}
            />
          </StaggerItem>
          
          <StaggerItem>
            <ServiceCard 
              icon='<svg fill="currentColor" viewBox="0 0 24 24"><path d="M12,2A2,2 0 0,1 14,4V8A2,2 0 0,1 12,10A2,2 0 0,1 10,8V4A2,2 0 0,1 12,2M21,11H20A8,8 0 0,1 12,19A8,8 0 0,1 4,11H3A1,1 0 0,1 2,10A1,1 0 0,1 3,9H4A8,8 0 0,1 12,1A8,8 0 0,1 20,9H21A1,1 0 0,1 22,10A1,1 0 0,1 21,11M7,11A5,5 0 0,0 12,16A5,5 0 0,0 17,11H16A4,4 0 0,1 12,15A4,4 0 0,1 8,11H7Z" /></svg>'
              title="Smart Lighting"
              description="Intelligent lighting systems that adapt to your schedule and preferences while saving energy."
              image="/images/services/lighting.png"
              features={[
                "Automated scheduling and scenes",
                "Voice control integration",
                "Energy-efficient LED bulbs",
                "Motion-activated lighting",
                "Color temperature adjustment"
              ]}
            />
          </StaggerItem>
          
          <StaggerItem>
            <ServiceCard 
              icon='<svg fill="currentColor" viewBox="0 0 24 24"><path d="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M12,13A1,1 0 0,1 11,12V8A1,1 0 0,1 13,8V12A1,1 0 0,1 12,13M12,17A1,1 0 0,1 11,16V15A1,1 0 0,1 13,15V16A1,1 0 0,1 12,17Z" /></svg>'
              title="Climate Control"
              description="Smart thermostats and HVAC systems for optimal comfort and energy efficiency year-round."
              image="/images/services/climate.png"
              features={[
                "Smart thermostat installation",
                "Zone-based climate control",
                "Energy usage monitoring",
                "Remote temperature adjustment",
                "Integration with weather data"
              ]}
            />
          </StaggerItem>
          
          <StaggerItem>
            <ServiceCard 
              icon='<svg fill="currentColor" viewBox="0 0 24 24"><path d="M21,3H3A2,2 0 0,0 1,5V19A2,2 0 0,0 3,21H21A2,2 0 0,0 23,19V5A2,2 0 0,0 21,3M21,19H3V5H21V19Z" /></svg>'
              title="Entertainment Systems"
              description="Immersive audio-visual setups with smart TVs, sound systems, and streaming integration."
              image="/images/services/entertainment.png"
              features={[
                "Multi-room audio systems",
                "Smart TV and streaming setup",
                "Home theater installation",
                "Voice-controlled entertainment",
                "Wireless speaker networks"
              ]}
            />
          </StaggerItem>
          
          <StaggerItem className="md:col-span-2 lg:col-span-1">
            <ServiceCard 
              icon='<svg fill="currentColor" viewBox="0 0 24 24"><path d="M4,1C2.89,1 2,1.89 2,3V7C2,8.11 2.89,9 4,9H1V11H13V9H10C11.11,9 12,8.11 12,7V3C12,1.89 11.11,1 10,1H4M4,3H10V7H4V3M14,13C12.89,13 12,13.89 12,15V19C12,20.11 12.89,21 14,21H11V23H23V21H20C21.11,21 22,20.11 22,19V15C22,13.89 21.11,13 20,13H14M14,15H20V19H14V15Z" /></svg>'
              title="Home Networking"
              description="Robust WiFi networks and smart home hubs for seamless connectivity throughout your home."
              image="/images/services/networking.png"
              features={[
                "High-speed WiFi 6 networks",
                "Smart home hub setup",
                "Network security configuration",
                "Device connectivity optimization",
                "Internet of Things integration"
              ]}
            />
          </StaggerItem>
        </StaggerContainer>
      </div>
    </section>
    
    <!-- Process Overview -->
    <section class="section-padding bg-soft-gray dark:bg-gray-800">
      <div class="container">
        <div class="text-center mb-16 reveal-on-scroll">
          <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-4">
            Professional Installation Process
          </h2>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Every installation follows our proven process to ensure quality, reliability, and your complete satisfaction.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <div class="text-center reveal-on-scroll">
            <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7-4a1 1 0 11-2 0 1 1 0 012 0zM9 9a1 1 0 000 2v3a1 1 0 001 1h1a1 1 0 100-2v-3a1 1 0 00-1-1H9z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Consultation</h3>
            <p class="text-gray-600 dark:text-gray-300">Free assessment and custom quote</p>
          </div>
          
          <div class="text-center reveal-on-scroll">
            <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M3 4a1 1 0 011-1h12a1 1 0 011 1v2a1 1 0 01-1 1H4a1 1 0 01-1-1V4zM3 10a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H4a1 1 0 01-1-1v-6zM14 9a1 1 0 00-1 1v6a1 1 0 001 1h2a1 1 0 001-1v-6a1 1 0 00-1-1h-2z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Planning</h3>
            <p class="text-gray-600 dark:text-gray-300">Custom system design and scheduling</p>
          </div>
          
          <div class="text-center reveal-on-scroll">
            <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Installation</h3>
            <p class="text-gray-600 dark:text-gray-300">Professional setup by certified techs</p>
          </div>
          
          <div class="text-center reveal-on-scroll">
            <div class="w-16 h-16 bg-teal rounded-full flex items-center justify-center mx-auto mb-4">
              <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                <path d="M10.394 2.08a1 1 0 00-.788 0l-7 3a1 1 0 000 1.84L5.25 8.051a.999.999 0 01.356-.257l4-1.714a1 1 0 11.788 1.838L7.667 9.088l1.94.831a1 1 0 00.787 0l7-3a1 1 0 000-1.838l-7-3z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Training</h3>
            <p class="text-gray-600 dark:text-gray-300">Complete setup and user training</p>
          </div>
        </div>
      </div>
    </section>
    

    
    <!-- CTA Section -->
    <section class="section-padding bg-teal text-white" data-hide-when="authed">
      <div class="container text-center">
        <h2 class="text-heading-lg font-bold mb-4 reveal-on-scroll">
          Ready to Get Started?
        </h2>
        <p class="text-body-lg mb-8 max-w-2xl mx-auto opacity-90 reveal-on-scroll">
          Contact us today for a free consultation and discover the perfect smart home solution for your needs.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center reveal-on-scroll">
          <a href="/contact" data-hide-when="authed" class="bg-white text-teal hover:bg-gray-100 px-8 py-3 rounded-lg font-medium transition-all duration-120 transform hover:scale-[1.02] btn-magnetic">
            Get Free Quote
          </a>
          <a href="tel:+15551234567" class="border-2 border-white text-white hover:bg-white hover:text-teal px-8 py-3 rounded-lg font-medium transition-all duration-120">
            Call (555) 123-4567
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<script>
  // @ts-nocheck
  // Hide elements marked data-hide-when="authed" for authenticated users based on localStorage.userEmail
  (function(){
    const toggleAuthedHides = (isAuthed) => {
      const nodes = document.querySelectorAll('[data-hide-when="authed"]');
      nodes.forEach((el) => {
        if (isAuthed) {
          el.classList.add('hidden');
          el.setAttribute('aria-hidden', 'true');
          el.style.display = 'none';
        } else {
          el.classList.remove('hidden');
          el.removeAttribute('aria-hidden');
          el.style.display = '';
        }
      });
    };
    function run(){
      let authed = false;
      try { authed = !!localStorage.getItem('userEmail'); } catch {}
      toggleAuthedHides(authed);
    }
    document.addEventListener('DOMContentLoaded', run);
    document.addEventListener('astro:page-load', run);
  })();
</script>