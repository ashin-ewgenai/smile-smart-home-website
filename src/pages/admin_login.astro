---
import Layout from '../layouts/Layout.astro';
import AdminLoginComponent from '../components/admin/AdminLogin';
---

<Layout title="Admin & Super Admin Login - Smile Smart Homes">
  <main class="min-h-screen flex items-center justify-center bg-gradient-to-br from-gray-900 to-gray-800 p-4">
    <div class="w-full max-w-md">
      <div class="text-center mb-8">
        <h1 class="text-3xl font-bold text-white">Smile Smart Homes</h1>
        <p class="text-gray-300">Administrator Login</p>
      </div>
      <div class="bg-gray-800 rounded-xl shadow-2xl overflow-hidden border border-gray-700">
        <AdminLoginComponent client:only="react" />
      </div>
      <div class="mt-6 text-center">
        <a href="/" class="text-sm text-blue-400 hover:text-blue-300 transition-colors">
          ← Return to Main Site
        </a>
      </div>
    </div>
  </main>
</Layout>
