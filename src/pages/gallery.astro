---
import Layout from '../layouts/Layout.astro';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';
import BeforeAfterSlider from '../components/BeforeAfterSlider';
import { StaggerContainer, StaggerItem } from '../components/MotionIsland';
---

<Layout title="Gallery - Smile Smart Homes">
  <Navigation />
  
  <main class="pt-16">
    <!-- Hero Section -->
    <section class="section-padding bg-gradient-to-br from-soft-gray via-white to-gray-100 dark:from-gray-900 dark:via-charcoal dark:to-gray-800">
      <div class="container">
        <div class="text-center max-w-4xl mx-auto reveal-on-scroll">
          <h1 class="text-display font-bold text-charcoal dark:text-white mb-6">
            Smart Home Transformations
          </h1>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-8">
            See how we've transformed homes with cutting-edge smart technology. From security systems to complete home automation.
          </p>
        </div>
      </div>
    </section>
    
    <!-- Before/After Section -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container">
        <div class="text-center mb-16 reveal-on-scroll">
          <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-4">
            Before & After Transformations
          </h2>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            See the dramatic difference smart home technology makes in real homes.
          </p>
        </div>
        
        <div class="max-w-4xl mx-auto space-y-16">
          <div class="reveal-on-scroll">
            <h3 class="text-2xl font-semibold text-charcoal dark:text-white mb-4 text-center">
              Living Room Entertainment Setup
            </h3>
            <BeforeAfterSlider 
              client:load
              beforeImage="/browser_gallery/traditional_entertainment.jpg"
              afterImage="/browser_gallery/smartroom_entertainment.jpg"
              beforeLabel="Traditional Setup"
              afterLabel="Smart Entertainment System"
            />
            <p class="text-center text-gray-600 dark:text-gray-300 mt-4">
              Complete smart TV installation with integrated sound system and voice control
            </p>
          </div>
          
          <div class="reveal-on-scroll">
            <h3 class="text-2xl font-semibold text-charcoal dark:text-white mb-4 text-center">
              Home Security Upgrade
            </h3>
            <BeforeAfterSlider 
              client:load
              beforeImage="/browser_gallery/traditional_security.jpg"
              afterImage="/browser_gallery/smart_security.jpg"
              beforeLabel="Basic Security"
              afterLabel="Smart Security System"
            />
            <p class="text-center text-gray-600 dark:text-gray-300 mt-4">
              Advanced security cameras, smart locks, and motion detection system
            </p>
          </div>
        </div>
      </div>
    </section>
    
    <!-- Project Gallery -->
    <section class="section-padding bg-soft-gray dark:bg-gray-800">
      <div class="container">
        <div class="text-center mb-16 reveal-on-scroll">
          <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-4">
            Our Recent Projects
          </h2>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Browse our portfolio of smart home installations and see the quality of our work.
          </p>
        </div>
        
        <StaggerContainer client:load className="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          <StaggerItem>
            <div class="bg-white dark:bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-200">
              <img 
                src="https://images.pexels.com/photos/1571468/pexels-photo-1571468.jpeg?auto=compress&cs=tinysrgb&w=500"
                alt="Smart lighting installation"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Smart Lighting System</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">Automated lighting with voice control and scheduling for a modern family home.</p>
                <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  Suburban Home, California
                </div>
              </div>
            </div>
          </StaggerItem>
          
          <StaggerItem>
            <div class="bg-white dark:bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-200">
              <img 
                src="/browser_gallery/security_camera.jpg"
                alt="Security camera installation"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Security Camera Network</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">Complete perimeter security with HD cameras and mobile monitoring.</p>
                <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  Downtown Apartment, Texas
                </div>
              </div>
            </div>
          </StaggerItem>
          
          <StaggerItem>
            <div class="bg-white dark:bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-200">
              <img 
                src="/browser_gallery/climate.jpg"
                alt="Smart thermostat installation"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Climate Control System</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">Smart thermostats with zone control for optimal comfort and efficiency.</p>
                <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  Family Home, Florida
                </div>
              </div>
            </div>
          </StaggerItem>
          
          <StaggerItem>
            <div class="bg-white dark:bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-200">
              <img 
                src="/browser_gallery/entertainment_hub.jpg"
                alt="Home entertainment system"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Entertainment Hub</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">Multi-room audio system with smart TV integration and streaming setup.</p>
                <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  Modern Condo, New York
                </div>
              </div>
            </div>
          </StaggerItem>
          
          <StaggerItem>
            <div class="bg-white dark:bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-200">
              <img 
                src="/browser_gallery/control_acess.jpg"
                alt="Smart door lock installation"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Smart Access Control</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">Keyless entry system with remote access and visitor management.</p>
                <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  Townhouse, Washington
                </div>
              </div>
            </div>
          </StaggerItem>
          
          <StaggerItem>
            <div class="bg-white dark:bg-gray-900 rounded-lg overflow-hidden shadow-lg hover:shadow-xl transition-shadow duration-200">
              <img 
                src="/browser_gallery/home-automation.jpg"
                alt="Complete smart home setup"
                class="w-full h-48 object-cover"
                loading="lazy"
              />
              <div class="p-6">
                <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">Complete Home Automation</h3>
                <p class="text-gray-600 dark:text-gray-300 mb-4">Full smart home integration with unified control and automation routines.</p>
                <div class="flex items-center text-sm text-gray-500 dark:text-gray-400">
                  <svg class="w-4 h-4 mr-1" fill="currentColor" viewBox="0 0 20 20">
                    <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"></path>
                  </svg>
                  Luxury Home, Colorado
                </div>
              </div>
            </div>
          </StaggerItem>
        </StaggerContainer>
      </div>
    </section>
    
    <!-- Client Testimonials -->
    <section class="section-padding bg-white dark:bg-gray-900">
      <div class="container">
        <div class="text-center mb-16 reveal-on-scroll">
          <h2 class="text-heading-lg font-bold text-charcoal dark:text-white mb-4">
            What Our Clients Say
          </h2>
          <p class="text-body-lg text-gray-600 dark:text-gray-300 max-w-2xl mx-auto">
            Real feedback from homeowners who've experienced our smart home transformations.
          </p>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="bg-soft-gray dark:bg-gray-800 rounded-lg p-6 reveal-on-scroll">
            <div class="flex items-center mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              ))}
            </div>
            <blockquote class="text-gray-600 dark:text-gray-300 mb-4 italic">
              "The transformation of our home is incredible. The team was professional, efficient, and the results exceeded our expectations. Our smart security system gives us peace of mind."
            </blockquote>
            <div class="flex items-center">
              <div class="w-10 h-10 bg-teal rounded-full flex items-center justify-center text-white font-semibold mr-3">
                JD
              </div>
              <div>
                <div class="font-semibold text-charcoal dark:text-white">Jennifer Davis</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Homeowner, California</div>
              </div>
            </div>
          </div>
          
          <div class="bg-soft-gray dark:bg-gray-800 rounded-lg p-6 reveal-on-scroll">
            <div class="flex items-center mb-4">
              {[...Array(5)].map(() => (
                <svg class="w-5 h-5 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
                </svg>
              ))}
            </div>
            <blockquote class="text-gray-600 dark:text-gray-300 mb-4 italic">
              "From consultation to completion, the service was outstanding. Our smart lighting and entertainment system work flawlessly. The energy savings alone make it worth it."
            </blockquote>
            <div class="flex items-center">
              <div class="w-10 h-10 bg-teal rounded-full flex items-center justify-center text-white font-semibold mr-3">
                RT
              </div>
              <div>
                <div class="font-semibold text-charcoal dark:text-white">Robert Thompson</div>
                <div class="text-sm text-gray-500 dark:text-gray-400">Tech Professional, Texas</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <!-- CTA Section -->
    <section class="section-padding bg-teal text-white">
      <div class="container text-center">
        <h2 class="text-heading-lg font-bold mb-4 reveal-on-scroll">
          Ready for Your Smart Home Transformation?
        </h2>
        <p class="text-body-lg mb-8 max-w-2xl mx-auto opacity-90 reveal-on-scroll">
          Let us help you create the smart home of your dreams. Contact us today for a free consultation and quote.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center reveal-on-scroll">
          <a href="/contact" class="bg-white text-teal hover:bg-gray-100 px-8 py-3 rounded-lg font-medium transition-all duration-120 transform hover:scale-[1.02] btn-magnetic">
            Get Free Quote
          </a>
          <a href="tel:+15551234567" class="border-2 border-white text-white hover:bg-white hover:text-teal px-8 py-3 rounded-lg font-medium transition-all duration-120">
            Call (555) 123-4567
          </a>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>