---
import Layout from '../layouts/Layout.astro';
import Navigation from './Navigation.astro';
import Footer from './Footer.astro';
import { EnergySavingsCalculator } from '../components/EnergySavingsCalculator';
import { DevicesProvider } from '../contexts/DevicesContext';
---

<Layout 
  title="Energy Savings Calculator | Smile Smart Homes"
  description="Calculate your potential annual savings with Smile Smart Home devices. Our AI-driven simulator estimates efficiency gains for lighting, climate, and appliances."
>
  <Navigation />
  
  <main class="pt-24 min-h-screen bg-white dark:bg-charcoal">
    <EnergySavingsCalculator client:only="react" />
    
    <!-- Contextual CTA -->
    <section class="container mx-auto px-4 pb-20">
      <div class="bg-teal rounded-[2.5rem] p-10 md:p-16 text-center text-white relative overflow-hidden shadow-2xl shadow-teal/30">
        <div class="absolute top-0 left-0 w-full h-full bg-[url('/grid-white.svg')] opacity-10 pointer-events-none"></div>
        <div class="relative z-10">
          <h2 class="text-3xl md:text-5xl font-black mb-6">Ready to Start Saving?</h2>
          <p class="text-white/80 text-lg max-w-2xl mx-auto mb-10">
            Get a personalized smart home recommendation based on your unique personality and lifestyle preferences.
          </p>
          <div class="flex flex-col sm:flex-row gap-4 justify-center">
            <a href="/services#preferences" class="px-10 py-5 bg-white text-teal font-black rounded-2xl shadow-xl hover:shadow-2xl hover:scale-105 transition-all">
              AI Recommendation Tool
            </a>
            <a href="/contact" class="px-10 py-5 bg-teal-900/20 backdrop-blur-md text-white border border-white/20 font-black rounded-2xl hover:bg-teal-900/30 transition-all">
              Talk to an Expert
            </a>
          </div>
        </div>
      </div>
    </section>
  </main>
  
  <Footer />
</Layout>

<style>
  main {
    background-image: 
      radial-gradient(circle at 0% 0%, rgba(20, 184, 166, 0.03) 0%, transparent 50%),
      radial-gradient(circle at 100% 100%, rgba(59, 130, 246, 0.03) 0%, transparent 50%);
  }
</style>
