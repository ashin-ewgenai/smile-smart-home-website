---
import { motion } from 'framer-motion';
import { Camera, Sparkles, MapPin, ArrowRight, Zap, Shield } from 'lucide-react';

/**
 * AI Room Visualizer Section - Prominent, premium layout.
 */
---

<section class="section-padding bg-white dark:bg-gray-900 relative overflow-hidden">
  <!-- Dynamic Orbs for background flare -->
  <div class="absolute -top-24 -left-24 w-96 h-96 bg-teal/5 rounded-full blur-[100px] pointer-events-none"></div>
  <div class="absolute -bottom-24 -right-24 w-96 h-96 bg-blue-500/5 rounded-full blur-[100px] pointer-events-none"></div>

  <div class="container relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
      
      <!-- Left: Visual Content (Mock UI) -->
      <div class="order-2 lg:order-1 reveal-on-scroll">
        <div class="relative group">
          <!-- Main visual container -->
          <div class="relative rounded-[2.5rem] bg-slate-100 dark:bg-charcoal p-4 md:p-6 shadow-2xl border border-gray-200 dark:border-gray-800 overflow-hidden transform group-hover:scale-[1.01] transition-all duration-700">
            
            <!-- Mock Room Photo -->
            <div class="relative rounded-2xl overflow-hidden aspect-[4/3] bg-black">
              <img 
                src="/images/scene_smart_home_concept.png" 
                alt="AI Visualization Mockup" 
                class="w-full h-full object-cover opacity-80 group-hover:scale-105 transition-transform duration-1000"
              />
              
              <!-- AI Pulse Ring -->
              <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-32 h-32 border-2 border-teal/40 rounded-full animate-ping pointer-events-none"></div>
              
              <!-- Mock Markers -->
              <div class="absolute top-1/4 left-1/3 w-10 h-10 bg-teal border-2 border-white rounded-full flex items-center justify-center text-white shadow-xl animate-bounce" style="animation-delay: 0.2s;">
                <Zap size={18} />
              </div>
              <div class="absolute top-1/2 right-1/4 w-10 h-10 bg-teal border-2 border-white rounded-full flex items-center justify-center text-white shadow-xl animate-bounce" style="animation-delay: 0.5s;">
                <Camera size={18} />
              </div>
              <div class="absolute bottom-1/3 left-1/2 w-10 h-10 bg-teal border-2 border-white rounded-full flex items-center justify-center text-white shadow-xl animate-bounce" style="animation-delay: 0.8s;">
                <MapPin size={18} />
              </div>

              <!-- AI Scanning Effect -->
              <div class="absolute inset-0 bg-gradient-to-b from-teal/20 to-transparent h-12 w-full animate-scan pointer-events-none"></div>
            </div>

            <!-- Dashboard Stats Overlay -->
            <div class="absolute top-12 right-12 bg-white/90 dark:bg-gray-800/90 backdrop-blur px-4 py-3 rounded-2xl shadow-xl border border-white/20">
              <div class="flex items-center gap-2 mb-1">
                <Sparkles size={14} className="text-teal" />
                <span class="text-[10px] font-black uppercase text-slate-500 tracking-widest">AI Result</span>
              </div>
              <div class="text-sm font-bold text-slate-800 dark:text-white">System Optimized</div>
            </div>
          </div>

          <!-- Feature floating cards -->
          <div class="absolute -bottom-8 -left-8 md:bottom-20 md:-left-12 bg-white dark:bg-gray-800 p-6 rounded-3xl shadow-2xl border border-gray-100 dark:border-gray-700 max-w-[200px]">
            <div class="w-10 h-10 bg-teal/10 rounded-xl flex items-center justify-center text-teal mb-3">
               <Shield size={20} />
            </div>
            <h4 class="font-bold text-slate-800 dark:text-white mb-1">Smart Mapping</h4>
            <p class="text-xs text-slate-500 leading-relaxed">Precision device placement for maximum coverage.</p>
          </div>
        </div>
      </div>

      <!-- Right: Text Content -->
      <div class="order-1 lg:order-2 reveal-on-scroll">
        <div class="flex items-center gap-3 mb-6">
          <div class="h-1 w-12 bg-teal rounded-full"></div>
          <span class="text-xs font-black text-teal uppercase tracking-[0.4em]">Proprietary AI</span>
        </div>
        
        <h2 class="text-4xl md:text-5xl lg:text-6xl font-black text-charcoal dark:text-white mb-8 leading-[1.1] tracking-tight">
          See Your Future <span class="text-teal">Smart Home</span> Before It Exists
        </h2>

        <p class="text-lg text-slate-600 dark:text-gray-400 mb-10 leading-relaxed font-medium">
          Upload a photo of your room and let our advanced Vision AI identify the perfect installation points. No guesswork, just precision placement for security cameras, lighting, and WiFi nodes.
        </p>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 mb-12">
           {[
             { t: "Instant Analysis", d: "Maps layout, lighting, and WiFi dead zones in seconds.", i: <Zap size={20}/> },
             { t: "Easy Upload", d: "Works with any standard mobile or professional camera photo.", i: <Camera size={20}/> }
           ].map(item => (
             <div class="flex gap-4">
                <div class="w-12 h-12 bg-teal/5 dark:bg-teal-900/10 text-teal rounded-2xl flex items-center justify-center shrink-0">
                   {item.i}
                </div>
                <div>
                   <h4 class="font-bold text-charcoal dark:text-white">{item.t}</h4>
                   <p class="text-sm text-slate-500 dark:text-gray-500">{item.d}</p>
                </div>
             </div>
           ))}
        </div>

        <div class="flex flex-col sm:flex-row gap-5">
          <a href="/room-visualizer" class="inline-flex items-center justify-center gap-3 bg-gradient-to-r from-teal to-blue-600 text-white px-10 py-5 rounded-[24px] font-black italic shadow-[0_20px_40px_rgba(0,150,136,0.3)] hover:scale-105 transition-all group">
            Open Room Visualizer
            <ArrowRight size={20} class="group-hover:translate-x-1 transition-transform" />
          </a>
          <a href="/services" class="inline-flex items-center justify-center gap-3 bg-soft-gray dark:bg-gray-800 text-charcoal dark:text-white px-8 py-5 rounded-[24px] font-bold hover:bg-gray-200 dark:hover:bg-gray-700 transition-all">
            Learn More
          </a>
        </div>
      </div>

    </div>
  </div>
</section>

<style>
  @keyframes scan {
    0% { top: 0%; opacity: 0; }
    50% { opacity: 0.5; }
    100% { top: 100%; opacity: 0; }
  }
  .animate-scan {
    animation: scan 3s infinite ease-in-out;
  }
</style>
