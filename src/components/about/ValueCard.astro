---
export interface Props {
  icon: string;
  title: string;
  description: string;
}

const { icon, title, description } = Astro.props;
---

<div class="card p-6 reveal-on-scroll">
  <div class="w-12 h-12 bg-teal/10 dark:bg-teal/20 rounded-lg flex items-center justify-center mb-4">
    <div set:html={icon} class="w-6 h-6 text-teal"></div>
  </div>
  <h3 class="text-xl font-semibold text-charcoal dark:text-white mb-2">{title}</h3>
  <p class="text-gray-600 dark:text-gray-300">{description}</p>
</div>