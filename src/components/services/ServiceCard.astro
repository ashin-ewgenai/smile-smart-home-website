---
export interface Props {
  icon: string;
  title: string;
  description: string;
  features: string[];
  image?: string;
}

const { icon, title, description, features, image } = Astro.props;
---

<div class="group relative card p-8 transition-all duration-500 hover:shadow-2xl hover:-translate-y-2 overflow-hidden reveal-on-scroll">
  <!-- 3D Visualization Overlay (Hover) -->
  {image && (
    <div class="absolute inset-0 z-0 opacity-0 group-hover:opacity-100 transition-opacity duration-700 pointer-events-none">
      <div class="absolute inset-0 bg-gradient-to-t from-white via-white/95 to-transparent dark:from-charcoal dark:via-charcoal/95 dark:to-transparent z-10" />
      <img 
        src={image} 
        alt={`${title} Visualization`}
        class="w-full h-full object-cover scale-110 group-hover:scale-100 transition-transform duration-1000 blur-[2px] group-hover:blur-0"
      />
    </div>
  )}

  <div class="relative z-10">
    <div class="w-16 h-16 bg-teal/10 dark:bg-teal/20 rounded-2xl flex items-center justify-center mb-6 transition-all duration-500 group-hover:bg-teal group-hover:text-white group-hover:scale-110 shadow-lg shadow-teal/5">
      <div set:html={icon} class="w-8 h-8 text-teal group-hover:text-white transition-colors"></div>
    </div>
    
    <h3 class="text-2xl font-black text-charcoal dark:text-white mb-4 tracking-tight group-hover:text-teal transition-colors">
      {title}
    </h3>
    <p class="text-gray-600 dark:text-gray-400 mb-8 leading-relaxed font-medium">
      {description}
    </p>
    
    <ul class="space-y-4 mb-8">
      {features.map(feature => (
        <li class="flex items-start text-sm font-semibold text-gray-500 dark:text-gray-400 group-hover:text-gray-700 dark:group-hover:text-gray-200 transition-colors">
          <div class="mt-1 mr-3 p-0.5 rounded-full bg-teal/10 text-teal group-hover:bg-teal group-hover:text-white transition-all">
            <svg class="w-3 h-3" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
            </svg>
          </div>
          {feature}
        </li>
      ))}
    </ul>
    
    <div class="pt-2">
      <a 
        href="/contact" 
        class="inline-flex items-center gap-2 text-teal font-black text-sm uppercase tracking-widest hover:gap-3 transition-all"
      >
        Get Detailed Quote
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</div>