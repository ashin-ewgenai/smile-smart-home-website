---
import { HeroMotion } from './MotionIsland';
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden bg-gradient-to-br from-soft-gray via-white to-gray-50 dark:from-gray-900 dark:via-charcoal dark:to-gray-800">
  <!-- Enhanced Background Pattern -->
  <div class="absolute inset-0" id="hero-bg">
    <!-- Primary gradient overlay -->
    <div class="absolute inset-0 bg-gradient-to-br from-teal/5 via-transparent to-teal/10 dark:from-teal/10 dark:via-transparent dark:to-teal/5"></div>
    
    <!-- Animated gradient orbs -->
    <div class="absolute top-1/4 left-1/4 w-96 h-96 bg-teal/20 dark:bg-teal/30 rounded-full blur-3xl animate-pulse"></div>
    <div class="absolute bottom-1/4 right-1/4 w-80 h-80 bg-teal/15 dark:bg-teal/25 rounded-full blur-3xl animate-pulse" style="animation-delay: 1s;"></div>
    
    <!-- Geometric patterns -->
    <div class="absolute inset-0 opacity-30 dark:opacity-20">
      <div class="absolute top-20 left-20 w-2 h-2 bg-teal rounded-full animate-ping" style="animation-delay: 0.5s;"></div>
      <div class="absolute top-40 right-32 w-1 h-1 bg-teal rounded-full animate-ping" style="animation-delay: 1.5s;"></div>
      <div class="absolute bottom-32 left-1/3 w-1.5 h-1.5 bg-teal rounded-full animate-ping" style="animation-delay: 2s;"></div>
      <div class="absolute bottom-20 right-20 w-2 h-2 bg-teal rounded-full animate-ping" style="animation-delay: 2.5s;"></div>
    </div>
  </div>

  <div class="container relative z-10">
    <HeroMotion client:load>
      <div class="max-w-5xl mx-auto">
        <!-- Badge/Tag -->
        <div class="flex justify-center mb-8">
          <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/80 dark:bg-gray-800/80 backdrop-blur-sm rounded-full border border-gray-200/50 dark:border-gray-700/50 shadow-sm">
            <div class="w-2 h-2 bg-teal rounded-full animate-pulse"></div>
            <span class="text-sm font-medium text-gray-700 dark:text-gray-300">Professional Smart Home Installation</span>
          </div>
        </div>

        <!-- Main Content -->
        <div class="text-center">
          <h1 class="text-display font-bold text-charcoal dark:text-white mb-6 leading-tight">
            Smarter living <span class="text-teal relative">
              starts here
              <div class="absolute -bottom-2 left-0 right-0 h-1 bg-gradient-to-r from-teal/40 to-teal/60 rounded-full"></div>
            </span>
          </h1>
          
          <p class="text-body-lg text-gray-600 dark:text-gray-300 mb-10 max-w-3xl mx-auto leading-relaxed">
            Professional smart device installation for safer, efficient homes. Transform 
            your living space with cutting-edge technology and expert setup.
          </p>
          
          <!-- Enhanced CTA Section -->
          <div class="flex flex-col sm:flex-row gap-4 justify-center items-center mb-12">
            <a href="/contact" class="btn-primary group relative overflow-hidden">
              <span class="relative z-10 flex items-center gap-2">
                Get Free Consultation
                <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                </svg>
              </span>
              <div class="absolute inset-0 bg-gradient-to-r from-teal to-teal/80 opacity-0 group-hover:opacity-100 transition-opacity"></div>
            </a>
            <a href="/services" class="btn-secondary group">
              <span class="flex items-center gap-2">
                View Services
                <svg class="w-4 h-4 transition-transform group-hover:scale-110" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
                </svg>
              </span>
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="flex flex-col sm:flex-row items-center justify-center gap-6 text-sm text-gray-500 dark:text-gray-400">
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-teal" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Licensed & Insured</span>
            </div>
            <div class="hidden sm:block w-px h-4 bg-gray-300 dark:bg-gray-600"></div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-teal" fill="currentColor" viewBox="0 0 20 20">
                <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"></path>
              </svg>
              <span>500+ Happy Customers</span>
            </div>
            <div class="hidden sm:block w-px h-4 bg-gray-300 dark:bg-gray-600"></div>
            <div class="flex items-center gap-2">
              <svg class="w-5 h-5 text-teal" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"></path>
              </svg>
              <span>Lifetime Support</span>
            </div>
          </div>
        </div>
      </div>
    </HeroMotion>
  </div>

  <!-- Modern Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2">
    <div class="flex flex-col items-center gap-2 animate-bounce">
      <span class="text-xs text-gray-400 dark:text-gray-500 font-medium">Scroll to explore</span>
      <div class="w-6 h-10 border-2 border-gray-300 dark:border-gray-600 rounded-full flex justify-center relative overflow-hidden">
        <div class="w-1 h-3 bg-teal rounded-full mt-2 animate-pulse"></div>
      </div>
    </div>
  </div>
</section>

<script>
  import { parallax } from '../lib/animate';
  
  // Initialize parallax on hero background
  const heroBackground = document.getElementById('hero-bg');
  if (heroBackground) {
    parallax(heroBackground, 0.1);
  }
</script>