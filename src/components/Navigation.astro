---
import DarkModeToggle from './DarkModeToggle';
---

<header class="fixed top-0 left-0 right-0 z-50 bg-white/90 dark:bg-charcoal/90 backdrop-blur-sm border-b border-gray-200 dark:border-gray-700">
  <nav class="container mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2 text-xl font-semibold text-charcoal dark:text-white">
        <div class="w-8 h-8 bg-teal rounded-lg flex items-center justify-center">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="white">
            <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
          </svg>
        </div>
        <span>Smile Smart Homes</span>
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class="text-gray-700 dark:text-gray-300 hover:text-teal transition-colors">Home</a>
        <a href="/services" class="text-gray-700 dark:text-gray-300 hover:text-teal transition-colors">Services</a>
        <a href="/about" class="text-gray-700 dark:text-gray-300 hover:text-teal transition-colors">About</a>
        <a href="/gallery" class="text-gray-700 dark:text-gray-300 hover:text-teal transition-colors">Gallery</a>
        <a href="/contact" class="text-gray-700 dark:text-gray-300 hover:text-teal transition-colors">Contact</a>
      </div>

      <!-- Right side -->
      <div class="flex items-center space-x-4">
        <DarkModeToggle client:load />
        <a href="/contact" class="btn-primary btn-magnetic">Get Quote</a>
        
        <!-- Mobile menu button -->
        <button class="md:hidden p-2 rounded-lg hover:bg-gray-100 dark:hover:bg-gray-800" id="mobile-menu-button">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
          </svg>
        </button>
      </div>
    </div>

    <!-- Mobile Navigation -->
    <div class="md:hidden hidden" id="mobile-menu">
      <div class="px-2 pt-2 pb-3 space-y-1 bg-white dark:bg-charcoal border-t border-gray-200 dark:border-gray-700">
        <a href="/" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-teal">Home</a>
        <a href="/services" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-teal">Services</a>
        <a href="/about" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-teal">About</a>
        <a href="/gallery" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-teal">Gallery</a>
        <a href="/contact" class="block px-3 py-2 text-gray-700 dark:text-gray-300 hover:text-teal">Contact</a>
      </div>
    </div>
  </nav>
</header>

<script>
  // Mobile menu toggle
  const mobileMenuButton = document.getElementById('mobile-menu-button');
  const mobileMenu = document.getElementById('mobile-menu');

  mobileMenuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script>