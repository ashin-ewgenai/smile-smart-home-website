---
// ResetPasswordModal.astro
// Modal that opens automatically when URL has Firebase password reset params
// Handles verifyPasswordResetCode and confirmPasswordReset
// Usage: include this component near the root so it can auto-open on load
---

<div id="reset-password-modal" class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/50 backdrop-blur-sm">
  <div class="relative w-[92vw] max-w-xl max-h-[90vh]">
    <div class="relative bg-white dark:bg-gray-900 rounded-2xl shadow-2xl ring-1 ring-black/10 dark:ring-white/10 overflow-hidden">
      <!-- Header -->
      <div class="px-6 pt-6 pb-2 flex items-center justify-between">
        <h3 class="text-2xl font-bold text-charcoal dark:text-white">Reset Password</h3>
        <button id="rp-close" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-300">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M6.72 6.72a.75.75 0 0 1 1.06 0L12 10.94l4.22-4.22a.75.75 0 1 1 1.06 1.06L13.06 12l4.22 4.22a.75.75 0 1 1-1.06 1.06L12 13.06l-4.22 4.22a.75.75 0 1 1-1.06-1.06L10.94 12 6.72 7.78a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/></svg>
        </button>
      </div>

      <!-- Body -->
      <div class="p-6 sm:p-8 space-y-5">
        <div id="rp-status" class="text-sm"></div>
        <div id="rp-form" class="space-y-3 hidden">
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">New password</label>
            <input id="rp-pass" type="password" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal" placeholder="••••••••" />
          </div>
          <div>
            <label class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Confirm password</label>
            <input id="rp-pass2" type="password" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal" placeholder="••••••••" />
          </div>
          <button id="rp-submit" class="w-full btn-primary" >Set New Password</button>
          <p id="rp-message" class="text-sm"></p>
        </div>
      </div>
    </div>
  </div>
</div>

<script type="module">
  import { auth } from '/src/lib/firebase.ts';
  import { verifyPasswordResetCode, confirmPasswordReset } from '/src/lib/firebase-auth-client.ts';

  const modal = document.getElementById('reset-password-modal');
  const closeBtn = document.getElementById('rp-close');
  const formWrap = document.getElementById('rp-form');
  const statusEl = document.getElementById('rp-status');
  const pass1 = document.getElementById('rp-pass');
  const pass2 = document.getElementById('rp-pass2');
  const submitBtn = document.getElementById('rp-submit');
  const msgEl = document.getElementById('rp-message');

  let currentOobCode = '';

  function openModal() {
    modal?.classList.remove('hidden');
    modal?.classList.add('flex');
    document.documentElement.classList.add('overflow-hidden');
  }
  function closeModal() {
    modal?.classList.add('hidden');
    modal?.classList.remove('flex');
    document.documentElement.classList.remove('overflow-hidden');
  }

  window.addEventListener('open-reset-password', openModal);
  window.addEventListener('close-reset-password', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  closeBtn?.addEventListener('click', closeModal);

  function validPassword(v){
    return /^(?=.*[a-z])(?=.*[A-Z])(?=.*\d).{8,}$/.test(v);
  }

  async function initFromURL(){
    try {
      const url = new URL(window.location.href);
      const mode = url.searchParams.get('mode');
      const oobCode = url.searchParams.get('oobCode');
      if (mode === 'resetPassword' && oobCode) {
        currentOobCode = oobCode;
        openModal();
        if (statusEl) { statusEl.textContent = 'Verifying reset link...'; statusEl.className = 'text-sm text-gray-600 dark:text-gray-300'; }
        try {
          const email = await verifyPasswordResetCode(auth, oobCode);
          if (statusEl) { statusEl.textContent = `Reset password for ${email}`; statusEl.className = 'text-sm text-emerald-600'; }
          formWrap?.classList.remove('hidden');
        } catch (err){
          if (statusEl) { statusEl.textContent = 'Invalid or expired reset link. Please request a new one.'; statusEl.className = 'text-sm text-red-600'; }
        }
      }
    } catch {}
  }

  async function submitNewPassword(){
    const p1 = pass1 && pass1 instanceof HTMLInputElement ? pass1.value : '';
    const p2 = pass2 && pass2 instanceof HTMLInputElement ? pass2.value : '';
    if (msgEl) msgEl.textContent = '';
    if (!p1 || !p2) {
      if (msgEl) { msgEl.textContent = 'Please enter and confirm your new password.'; msgEl.className = 'text-sm text-red-600'; }
      return;
    }
    if (p1 !== p2) {
      if (msgEl) { msgEl.textContent = 'Passwords do not match.'; msgEl.className = 'text-sm text-red-600'; }
      return;
    }
    if (!validPassword(p1)){
      if (msgEl) { msgEl.textContent = 'Password must be at least 8 chars with upper, lower and number.'; msgEl.className = 'text-sm text-red-600'; }
      return;
    }
    submitBtn?.setAttribute('disabled','true');
    try {
      await confirmPasswordReset(auth, currentOobCode, p1);
      if (msgEl) { msgEl.textContent = 'Password updated! Opening sign in...'; msgEl.className = 'text-sm text-emerald-600'; }
      setTimeout(() => {
        try {
          // If global AuthModal helpers are available, open login view
          if (typeof window !== 'undefined' && (window)['__authOpen']) {
            (window)['__authOpen']('login');
          } else {
            window.location.href = '/';
          }
        } catch {
          window.location.href = '/';
        }
      }, 800);
    } catch (err){
      const message = err && err.message ? err.message : 'Failed to update password.';
      if (msgEl) { msgEl.textContent = String(message); msgEl.className = 'text-sm text-red-600'; }
    } finally {
      submitBtn?.removeAttribute('disabled');
    }
  }

  submitBtn?.addEventListener('click', submitNewPassword);
  // auto-init on load
  if (typeof window !== 'undefined') initFromURL();
</script>
