---
// ForgotPasswordModal.astro
// Modal to send password reset email using Firebase Auth
// Usage: Place this component near the root of your pages/layout so it's available globally.
// Open it by dispatching: window.dispatchEvent(new CustomEvent('open-forgot-password'))
// Close by clicking backdrop, the X button, or programmatically dispatching 'close-forgot-password'.
---

<div id="forgot-password-modal" class="fixed inset-0 z-[110] hidden items-center justify-center bg-black/50 backdrop-blur-sm">
  <div class="relative w-[92vw] max-w-md max-h-[90vh]">
    <div class="relative bg-white dark:bg-gray-900 rounded-2xl shadow-2xl ring-1 ring-black/10 dark:ring-white/10 overflow-hidden">
      <!-- Header -->
      <div class="px-6 pt-6 pb-2 flex items-center justify-between">
        <h3 class="text-lg font-semibold text-gray-900 dark:text-white">Forgot Password</h3>
        <button id="fp-close" class="inline-flex items-center justify-center w-9 h-9 rounded-full bg-gray-100 hover:bg-gray-200 dark:bg-gray-800 dark:hover:bg-gray-700 text-gray-600 dark:text-gray-300">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" class="w-5 h-5"><path fill-rule="evenodd" d="M6.72 6.72a.75.75 0 0 1 1.06 0L12 10.94l4.22-4.22a.75.75 0 1 1 1.06 1.06L13.06 12l4.22 4.22a.75.75 0 1 1-1.06 1.06L12 13.06l-4.22 4.22a.75.75 0 1 1-1.06-1.06L10.94 12 6.72 7.78a.75.75 0 0 1 0-1.06z" clip-rule="evenodd"/></svg>
        </button>
      </div>

      <!-- Body -->
      <div class="p-6 space-y-4">
        <p class="text-sm text-gray-600 dark:text-gray-300">Enter your email and we'll send you a password reset link.</p>
        <div>
          <label for="fp-email" class="block text-sm font-medium text-gray-700 dark:text-gray-300 mb-1">Email</label>
          <input id="fp-email" type="email" class="w-full px-4 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-800 text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-teal" placeholder="you@example.com" />
        </div>
        <button id="fp-send" class="w-full px-4 py-2 rounded-lg bg-teal-600 hover:bg-teal-700 text-white disabled:opacity-50 disabled:cursor-not-allowed">Send Reset Link</button>
        <p id="fp-message" class="text-sm"></p>
      </div>
    </div>
  </div>
</div>

<script type="module">
  import { auth } from '/src/lib/firebase.ts';
  import { sendPasswordResetEmail } from '/src/lib/firebase-auth-client.ts';

  const modal = document.getElementById('forgot-password-modal');
  const closeBtn = document.getElementById('fp-close');
  const sendBtn = document.getElementById('fp-send');
  const emailInput = document.getElementById('fp-email');
  const msgEl = document.getElementById('fp-message');

  function openModal() {
    if (!modal) return;
    modal.classList.remove('hidden');
    modal.classList.add('flex');
    if (msgEl) { msgEl.textContent = ''; msgEl.className = 'text-sm'; }
    if (emailInput && emailInput instanceof HTMLInputElement) {
      emailInput.value = '';
    }
    document.documentElement.classList.add('overflow-hidden');
  }
  function closeModal() {
    if (!modal) return;
    modal.classList.add('hidden');
    modal.classList.remove('flex');
    document.documentElement.classList.remove('overflow-hidden');
  }

  window.addEventListener('open-forgot-password', openModal);
  window.addEventListener('close-forgot-password', closeModal);

  modal?.addEventListener('click', (e) => {
    if (e.target === modal) closeModal();
  });
  closeBtn?.addEventListener('click', closeModal);

  async function sendReset() {
    const email = emailInput && emailInput instanceof HTMLInputElement ? emailInput.value.trim() : '';
    if (!email) {
      if (msgEl) { msgEl.textContent = 'Please enter your email.'; msgEl.className = 'text-sm text-red-600'; }
      return;
    }
    sendBtn?.setAttribute('disabled','true');
    if (msgEl) msgEl.textContent = '';
    try {
      // Ensure the reset email redirects back to this site (with full layout/theme)
      const actionCodeSettings = {
        url: window.location.origin + '/auth',
        handleCodeInApp: true,
      };
      await sendPasswordResetEmail(auth, email, actionCodeSettings);
      if (msgEl) { msgEl.textContent = 'Reset link sent! Please check your email.'; msgEl.className = 'text-sm text-emerald-600'; }
    } catch (err) {
      const message = err && typeof err === 'object' && err !== null && 'message' in err ? (err)['message'] : 'Failed to send reset link.';
      if (msgEl) { msgEl.textContent = String(message); msgEl.className = 'text-sm text-red-600'; }
    } finally {
      sendBtn?.removeAttribute('disabled');
    }
  }
  sendBtn?.addEventListener('click', sendReset);
</script>
