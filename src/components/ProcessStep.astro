---
export interface Props {
  step: number;
  title: string;
  description: string;
  icon: string;
}

const { step, title, description, icon } = Astro.props;
---

<div class="reveal-on-scroll">
  <div class="flex items-start space-x-4">
    <div class="flex-shrink-0">
      <div class="w-12 h-12 bg-teal rounded-full flex items-center justify-center text-white font-semibold text-lg">
        {step}
      </div>
    </div>
    
    <div class="flex-grow">
      <div class="flex items-center mb-2">
        <div set:html={icon} class="w-6 h-6 text-teal mr-3"></div>
        <h3 class="text-xl font-semibold text-charcoal dark:text-white">{title}</h3>
      </div>
      <p class="text-gray-600 dark:text-gray-300">{description}</p>
    </div>
  </div>
  
  {step < 4 && (
    <div class="ml-6 mt-6 mb-6">
      <div class="w-px h-12 bg-gray-300 dark:bg-gray-600"></div>
    </div>
  )}
</div>