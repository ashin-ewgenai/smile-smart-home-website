---
export interface Props {
  icon: string;
  title: string;
  description: string;
  features: string[];
}

const { icon, title, description, features } = Astro.props;
---

<div class="card p-6 reveal-on-scroll">
  <div class="w-16 h-16 bg-teal/10 dark:bg-teal/20 rounded-xl flex items-center justify-center mb-6">
    <div set:html={icon} class="w-8 h-8 text-teal"></div>
  </div>
  
  <h3 class="text-2xl font-semibold text-charcoal dark:text-white mb-3">{title}</h3>
  <p class="text-gray-600 dark:text-gray-300 mb-6">{description}</p>
  
  <ul class="space-y-2 mb-6">
    {features.map(feature => (
      <li class="flex items-center text-gray-600 dark:text-gray-300">
        <svg class="w-4 h-4 text-teal mr-2 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"></path>
        </svg>
        {feature}
      </li>
    ))}
  </ul>
  
  <a href="/contact" class="btn-primary w-full text-center btn-magnetic">Get Quote</a>
</div>